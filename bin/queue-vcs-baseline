#!/usr/bin/env bash
# Read-only VCS baseline helper for BashQueues class authoring.
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
Usage: queue-vcs-baseline [--json] [--type auto|git|svn|cvs|hg|p4] [--timeout SECONDS] [--name NAME] [PATH]

Runs queue-vcs-probe and emits copy/paste-safe VCS_CHANGESET_AUDIT settings
for the observed workspace. It is read-only and never writes a baseline file or
runs checkout, update, commit, merge, tag, submit, or revert operations.
USAGE
}

json=0
type=auto
timeout_s=10
name=default
while [[ $# -gt 0 ]]; do
  case "$1" in
    --json|-j) json=1; shift ;;
    --type) [[ $# -ge 2 ]] || { echo "queue-vcs-baseline: --type requires a value" >&2; exit 2; }; type="$2"; shift 2 ;;
    --type=*) type="${1#*=}"; shift ;;
    --timeout) [[ $# -ge 2 ]] || { echo "queue-vcs-baseline: --timeout requires a value" >&2; exit 2; }; timeout_s="$2"; shift 2 ;;
    --timeout=*) timeout_s="${1#*=}"; shift ;;
    --name) [[ $# -ge 2 ]] || { echo "queue-vcs-baseline: --name requires a value" >&2; exit 2; }; name="$2"; shift 2 ;;
    --name=*) name="${1#*=}"; shift ;;
    --help|-h) usage; exit 0 ;;
    --*) echo "queue-vcs-baseline: unknown option: $1" >&2; usage; exit 2 ;;
    *) break ;;
  esac
done
path="${1:-.}"
[[ -d "$path" ]] || { echo "queue-vcs-baseline: not a directory: $path" >&2; exit 2; }

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
probe="$script_dir/queue-vcs-probe"
if [[ ! -x "$probe" ]]; then
  probe="$(command -v queue-vcs-probe || true)"
fi
[[ -n "$probe" ]] || { echo "queue-vcs-baseline: helper not found: queue-vcs-probe" >&2; exit 1; }

probe_json="$($probe --json --type "$type" --timeout "$timeout_s" "$path")"
python3 - "$json" "$name" "$probe_json" <<'PY'
import json, shlex, sys
json_mode = sys.argv[1] == "1"
name = sys.argv[2]
probe = json.loads(sys.argv[3])
keys = {
    "QUEUEBASH_VCS_AUDIT_NAME": name,
    "QUEUEBASH_VCS_AUDIT_REPO": probe.get("root") or probe.get("path") or "",
    "QUEUEBASH_VCS_AUDIT_TYPE": probe.get("type", ""),
    "QUEUEBASH_VCS_AUDIT_IDENTITY": probe.get("identity", ""),
    "QUEUEBASH_VCS_AUDIT_REVISION": probe.get("revision", ""),
    "QUEUEBASH_VCS_AUDIT_FINGERPRINT": probe.get("fingerprint", ""),
}
out = {
    "schema": "queuebash.vcs.baseline.v1",
    "read_only": True,
    "class": "VCS_CHANGESET_AUDIT",
    "probe_schema": probe.get("schema", ""),
    "type": probe.get("type", ""),
    "path": probe.get("path", ""),
    "root": probe.get("root", ""),
    "identity": probe.get("identity", ""),
    "revision": probe.get("revision", ""),
    "fingerprint": probe.get("fingerprint", ""),
    "clean": probe.get("clean", ""),
    "status_summary": probe.get("status_summary", ""),
    "env": keys,
}
if json_mode:
    print(json.dumps(out, sort_keys=True, separators=(",", ":")))
else:
    print("# BashQueues VCS_CHANGESET_AUDIT baseline")
    print("# Generated read-only from queue-vcs-probe; review before committing to policy.")
    print("# status_summary=%s clean=%s" % (out["status_summary"], out["clean"]))
    for key in (
        "QUEUEBASH_VCS_AUDIT_NAME",
        "QUEUEBASH_VCS_AUDIT_REPO",
        "QUEUEBASH_VCS_AUDIT_TYPE",
        "QUEUEBASH_VCS_AUDIT_IDENTITY",
        "QUEUEBASH_VCS_AUDIT_REVISION",
        "QUEUEBASH_VCS_AUDIT_FINGERPRINT",
    ):
        print("export %s=%s" % (key, shlex.quote(str(keys[key]))))
PY
