/* ============================================================
 * BashQueues.cls — Bob31 ooRexx JSON frontage merge
 *
 * Self-describing Open Object Rexx interface to bashqueues.
 * The surface is generated by interrogating the bash system at
 * init time. JSON is the primary frontage.
 *
 * Bob31 merge notes:
 *   - Keeps Claude's API shape, docs/examples/tests bundle direction.
 *   - Keeps shell quoting and pre-source environment export discipline.
 *   - Fixes JSON parsing for ooRexx json.cls by instantiating .json.
 *   - Keeps explain/health/cancel/stats/list/submit JSON-facing.
 *   - Avoids including the alchemy/bank learning examples.
 *
 * Requirements:
 *   Open Object Rexx 5.x
 *   ::requires "json.cls"
 *   QUEUEBASH_SOURCE may point at queuebash.sh when not installed globally.
 * ============================================================ */

::class ScriptFronted public

::attribute _binary unguarded
::attribute _root unguarded
::attribute _logFile unguarded
::attribute _sourceFile unguarded

::method init
  use arg root, binary, sourceFile
  if root == .nil then do
    root = value("QUEUEBASH_ROOT",,"ENVIRONMENT")
    if root = "" then root = value("HOME",,"ENVIRONMENT") || "/.queuebash"
  end
  if root = "ROOT" then root = value("QUEUEBASH_ROOT",,"ENVIRONMENT")
  if binary == .nil then binary = "queue"
  if binary = "BINARY" then binary = "queue"
  if sourceFile == .nil then do
    sourceFile = value("QUEUEBASH_SOURCE",,"ENVIRONMENT")
  end
  if sourceFile = "SOURCEFILE" then sourceFile = self~_findSourceFile

  self~_root       = root
  self~_binary     = binary
  self~_sourceFile = sourceFile
  self~_logFile    = root || "/oorexx_bq.log"
  .local["bq.last_error"] = ""

::method _findSourceFile private
  candidates = .Array~of( ,
    "/usr/local/share/bashqueues/queuebash.sh", ,
    "/usr/share/bashqueues/queuebash.sh", ,
    value("HOME",,"ENVIRONMENT") || "/bashqueues/queuebash.sh", ,
    value("HOME",,"ENVIRONMENT") || "/bashq/queuebash.sh")
  do cand over candidates
    if SysFileExists(cand) then return cand
  end
  return "/usr/local/share/bashqueues/queuebash.sh"

::method _run
  /* Run a queue command expected to return JSON. */
  use arg arglist
  raw = self~_runText(arglist)
  if raw = "" then return .nil
  return self~_parseJSON(raw)

::method _runText
  /* Run a queue command and return raw stdout text. */
  use arg arglist
  if arglist == .nil then arglist = ""

  path = value("PATH",,"ENVIRONMENT")
  body = "export PATH=" || self~_shquote(path) || "; " ||,
         "export QUEUEBASH_ROOT=" || self~_shquote(self~_root) || "; " ||,
         "export QUEUEBASH_ALLOW_NONINTERACTIVE=1; export NO_COLOR=1; " ||,
         "source " || self~_shquote(self~_sourceFile) || " >/dev/null 2>&1; " ||,
         self~_binary || " " || arglist
  cmd = "bash -c " || self~_shquote(body)

  outArr = .Array~new
  errArr = .Array~new
  self~_log("CMD", cmd)
  address system cmd with output using (outArr) error using (errArr)
  self~_log("RC", rc)
  do line over errArr; self~_log("ERR", line); end

  if rc \= 0 then do
    errmsg = "BQ error (rc=" || rc || ")"
    if errArr~items > 0 then errmsg = errmsg || ": " || errArr~at(1)
    .local["bq.last_error"] = errmsg
    return ""
  end



  out = ""
  do line over outArr
    self~_log("OUT", line)
    out = out || line
  end
  .local["bq.last_error"] = ""
  return out~strip("T")

::method _parseJSON private
  use arg text
  if text == .nil then do
    .local["bq.last_error"] = "JSON parse failed: nil text"
    return .nil
  end
  text = text~strip
  if text~length = 0 then do
    .local["bq.last_error"] = "JSON parse failed: empty text"
    return .nil
  end
  first = text~left(1)
  last  = text~right(1)
  if first \= "{" & first \= "[" then do
    .local["bq.last_error"] = "JSON parse failed: output did not start with JSON: " || text~left(120)
    return .nil
  end
  if last \= "}" & last \= "]" then do
    .local["bq.last_error"] = "JSON parse failed: output did not end with JSON: " || text~right(120)
    return .nil
  end
  json = .json~new
  return json~fromJson(text)

::method _shquote private
  /* Single-quote for POSIX shell. */
  use arg text
  if text == .nil then text = ""
  sq = "27"x
  bs = "5C"x
  return sq || text~changestr(sq, sq || bs || sq || sq) || sq

::method _log
  use arg label, text
  lf = self~_logFile
  if lf == .nil | lf = "" then return
  s = .Stream~new(lf)
  s~open("WRITE APPEND")
  do line over text~makeArray("0A"x)
    if line~strip \= "" then rc = s~lineout(time("L") " [" || label || "] " || line~strip)
  end
  s~close

::method root
  return self~_root

::method lastError
  return .local["bq.last_error"]


::class BQData public

::attribute _data

::method init
  use arg d
  self~_data = .Directory~new
  if d \== .nil & d~isA(.Directory) then self~_data = d

::method unknown
  use arg methodName, args
  m = methodName~upper
  if m = "RAW"    then return self~_data
  if m = "FIELDS" then return self~_data~allIndexes
  if m = "STRING" then return self~string

  prefix = methodName~left(3)~upper
  attr   = methodName~substr(4)
  key1   = attr~lower
  key2   = self~_toSnake(attr)

  select
    when prefix = "GET" then return self~at(key2, self~at(key1))
    when prefix = "HAS" then return (self~_data~hasIndex(key1) | self~_data~hasIndex(key2))
    when prefix = "SET" then do
      self~_data[key2] = args~at(1)
      return self
    end
    otherwise return self~at(methodName~lower)
  end

::method at
  use arg key, defaultValue
  if self~_data~hasIndex(key) then return self~_data[key]
  if arg() > 1 then return defaultValue
  return .nil

::method _toSnake private
  use arg name
  out = ""
  do i = 1 to name~length
    c = name~substr(i, 1)
    if c = c~upper & c \= c~lower then
      out = out || "_" || c~lower
    else
      out = out || c~lower
  end
  return out~strip("B", "_")

::method fields
  return self~_data~allIndexes

::method raw
  return self~_data

::method string
  parse value "qid id job_id name schema total status" with k1 k2 k3 k4 k5 k6 k7
  do key over .Array~of(k1, k2, k3, k4, k5, k6, k7)
    if self~_data~hasIndex(key) then return "BQData(" || key || "=" || self~_data[key] || ")"
  end
  return "BQData(" || self~_data~items || " fields)"


::class BQCollection public

::attribute items

::method init
  use arg arr, keyField
  self~items = .Array~new
  if arr == .nil then return
  do item over arr
    if item~isA(.Directory) then self~items~append(.BQData~new(item))
    else if item~isA(.BQData) then self~items~append(item)
  end

::method count
  return self~items~items

::method filter
  use arg fieldName, value
  filtered = .Array~new
  do item over self~items
    item~sendWith("get" || fieldName~left(1)~upper || fieldName~substr(2), .Array~new)
    if var("RESULT") & RESULT = value then filtered~append(item)
  end
  return .BQCollection~new(filtered)

::method makeArray
  return self~items

::method string
  return "BQCollection(" || self~items~items || " items)"


::class BQSurface public

::attribute commands
::attribute topLevel
::attribute loaded

::method init
  self~commands = .Directory~new
  self~topLevel = .Set~new
  self~loaded   = .false

::method loadFrom
  use arg functionsData
  if functionsData == .nil then return
  if functionsData~isA(.BQData) then functionsData = functionsData~raw
  fns = functionsData["functions"]
  if fns == .nil then return
  do entry over fns
    fname = entry["function"]
    if fname == .nil then iterate
    if fname~left(7) \= "_queue_" then iterate
    if fname~right(8) \= "_command" then iterate
    core = fname~substr(8)
    core = core~left(core~length - 8)
    path = core~changestr("_", " ")
    self~commands[path] = .true
    parse var path ns .
    self~topLevel~put(ns, ns)
  end
  self~loaded = .true

::method knows
  use arg path
  return self~commands~hasIndex(path)

::method namespaces
  return self~topLevel~allIndexes

::method string
  if \self~loaded then return "BQSurface(not loaded)"
  return "BQSurface(" || self~commands~items || " commands)"


::class BQNamespace public

::attribute _bq
::attribute _path

::method init
  use arg bq, path
  self~_bq   = bq
  self~_path = path

::method unknown
  use arg methodName, args
  seg     = methodName~lower~changestr("_", " ")
  newPath = self~_path || " " || seg
  if args~items > 0 then return self~execPath(newPath, args)
  return .BQNamespace~new(self~_bq, newPath)

::method execPath private
  use arg path, args
  argStr = ""
  do a over args
    if argStr \= "" then argStr = argStr || " "
    argStr = argStr || self~_bq~_shquote(a~string)
  end
  d = self~_bq~_run(path || " " || argStr || " --json")
  return self~_bq~_wrapResult(d)

::method json
  d = self~_bq~_run(self~_path || " --json")
  return self~_bq~_wrapResult(d)

::method text
  return self~_bq~_runText(self~_path)

::method exec
  use arg extraArgs
  if extraArgs == .nil then extraArgs = ""
  d = self~_bq~_run(self~_path || " " || extraArgs || " --json")
  return self~_bq~_wrapResult(d)

::method string
  return "BQNamespace(" || self~_path || ")"


::class BashQueues public subclass ScriptFronted

::attribute _surface unguarded

::method init
  use arg root, binary, sourceFile
  self~init:super(root, binary, sourceFile)
  self~_surface = .BQSurface~new
  self~refresh

::method user class
  use arg root, binary, sourceFile
  return .BashQueues~new(root, binary, sourceFile)

::method system class
  use arg root, sourceFile
  if root == .nil then root = "/var/lib/bashqueues"
  return .BashQueues~new(root, "queue", sourceFile)

::method refresh
  data = self~_run("dev functions --json")
  if data == .nil then do
    say "[BashQueues] surface not loaded: " || self~lastError
    say "[BashQueues] source: " || self~_sourceFile
    return .false
  end
  self~_surface~loadFrom(data)
  say "[BashQueues] surface loaded:" self~_surface~string
  return .true

::method unknown
  use arg methodName, args
  path = methodName~lower~changestr("_", " ")
  if args~items > 0 then do
    argStr = ""
    do a over args
      if argStr \= "" then argStr = argStr || " "
      argStr = argStr || self~_shquote(a~string)
    end
    d = self~_run(path || " " || argStr || " --json")
    return self~_wrapResult(d)
  end
  return .BQNamespace~new(self, path)

::method _wrapResult
  use arg d
  if d == .nil then return .nil
  if d~isA(.Array) then return .BQCollection~new(d)
  if d~isA(.Directory) then do
    do key over .Array~of("jobs", "items", "lessons", "functions", "events")
      if d~hasIndex(key) then do
        val = d[key]
        if val~isA(.Array) then return .BQCollection~new(val)
      end
    end
    return .BQData~new(d)
  end
  return d

::method stats
  return self~_wrapResult(self~_run("stats --json"))

::method version
  return self~_runText("version")

::method health
  return self~_wrapResult(self~_run("health --json"))

::method list
  return .BQNamespace~new(self, "list")

::method explain
  use arg qid
  return self~_wrapResult(self~_run("explain " || self~_shquote(qid) || " --json"))

::method cancel
  use arg qid
  return self~_wrapResult(self~_run("cancel " || self~_shquote(qid) || " --json"))

::method submit
  use arg name, commandArgs, opts
  if opts == .nil then opts = .Directory~new
  args = "submit " || self~_shquote(name) || " --json"
  p = opts["priority"]
  if p \== .nil then args = args || " --priority " || self~_shquote(p)
  c = opts["class"]
  if c \== .nil then args = args || " --class " || self~_shquote(c)
  r = opts["retries"]
  if r \== .nil then args = args || " --retries " || self~_shquote(r)
  if commandArgs \== .nil & commandArgs \= "" then do
    cmdStr = commandArgs~strip
    if cmdStr~left(3) = "-- " then cmdStr = cmdStr~substr(4)~strip
    else if cmdStr = "--" then cmdStr = ""
    if cmdStr \= "" then args = args || " -- " || cmdStr
  end
  return self~_wrapResult(self~_run(args))

::method surface
  say "BashQueues surface — known commands:"
  say "  Top-level namespaces:"
  do ns over self~_surface~namespaces
    say "    queue" ns
  end
  return self~_surface

::method string
  return "BashQueues(root=" || self~_root || " " || self~_surface~string || ")"

::requires "json.cls"
