# Example client-side config for: queue remote local-management ...
QUEUE_REMOTE_URL=http://127.0.0.1:8765
QUEUE_REMOTE_ENDPOINT=/remote-queue
QUEUE_REMOTE_CLIENT_ID=queue-admin
QUEUE_REMOTE_KEY_ID=default
QUEUE_REMOTE_SECRET_FILE=/etc/queuebash/policies.d/remote-queue/secrets/queue-admin.secret
QUEUE_REMOTE_REQUEST_TTL_SECONDS=60
QUEUE_REMOTE_HTTP_TIMEOUT_SECONDS=30
