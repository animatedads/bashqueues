# Example local Ollama provider configuration for queue ask.
# This is a local live provider and must be explicitly enabled by policy.

QUEUEBASH_AI_PROVIDER=ollama
QUEUEBASH_AI_MODEL=llama3
QUEUEBASH_AI_OLLAMA_MODEL=llama3
QUEUEBASH_AI_OLLAMA_URL=http://127.0.0.1:11434/api/generate

# Live provider calls are disabled by default. Enable only where policy permits.
QUEUEBASH_AI_LIVE_ENABLED=0

# Context bounds. The helper reads only policy-allowed context categories and
# skips likely secret material.
QUEUEBASH_AI_CONTEXT_FILE_BYTES=16000
QUEUEBASH_AI_CONTEXT_TOTAL_BYTES=120000
QUEUEBASH_AI_OLLAMA_TIMEOUT=180

# Optional context disclosure gates.
QUEUEBASH_AI_ALLOW_QUEUE_STATUS=0
QUEUEBASH_AI_ALLOW_POLICY_DETAILS=0
