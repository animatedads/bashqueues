# Example live Groq ask provider environment.
# Do not commit real credentials.

export QUEUEBASH_AI_LIVE_ENABLED=1
export QUEUEBASH_AI_PROVIDER=groq
export QUEUEBASH_AI_GROQ_MODEL=llama-3.3-70b-versatile
export QUEUEBASH_AI_GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
# export QUEUEBASH_AI_GROQ_API_KEY_FILE=/etc/bashqueues/secrets/groq-api-key
