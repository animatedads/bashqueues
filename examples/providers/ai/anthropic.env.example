# Example local Anthropic provider environment for queue ask.
# Source this only after supplying a key through a private file or secure shell env.

export QUEUEBASH_AI_LIVE_ENABLED=1
export QUEUEBASH_AI_ANTHROPIC_MODEL=claude-sonnet-4-20250514
export QUEUEBASH_AI_ANTHROPIC_API_KEY_FILE="$HOME/.config/bashqueues/anthropic-api-key"

# Example:
# queue ask --provider anthropic --live --context docs,tests --json "How do I inspect ask providers?"
