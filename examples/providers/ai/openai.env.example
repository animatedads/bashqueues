# Example local shell setup for queue ask OpenAI provider.
# Never put a real key in this file if it will be packaged, logged, or committed.
export QUEUEBASH_AI_PROVIDER=openai
export QUEUEBASH_AI_OPENAI_MODEL=gpt-4.1-mini
export QUEUEBASH_AI_OPENAI_API_KEY_FILE="$HOME/.config/queuebash/openai_api_key"
export QUEUEBASH_AI_LIVE_ENABLED=1
