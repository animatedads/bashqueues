# bashqueues Gemini advisory provider example
# Copy to a private shell/profile file and source it for testing.
# Do not commit real API keys.

# Live AI providers are disabled unless explicitly enabled.
export QUEUEBASH_AI_LIVE_ENABLED=1

# Recommended: keep the API key in a user/private file.
export QUEUEBASH_AI_GEMINI_API_KEY_FILE="$HOME/.queuebash/secrets/gemini_api_key"

# Temporary development alternatives, in lookup order after the key file:
# export QUEUEBASH_AI_GEMINI_API_KEY="..."
# export QUEUEBASH_AI_GEMINI_KEY="..."
# export GEMINI_API_KEY="..."
# export GOOGLE_API_KEY="..."

# Model and timeout are intentionally configurable.
export QUEUEBASH_AI_GEMINI_MODEL="gemini-2.5-flash"
export QUEUEBASH_AI_GEMINI_TIMEOUT=60
export QUEUEBASH_AI_GEMINI_MAX_OUTPUT_TOKENS=4096

# Example:
# queue ask --provider gemini --live --context docs,tests,classes \
#   "How do I submit a bashqueues job?"

# Diagnose model availability for this key/account:
#   queue-ai-ask-gemini --list-models
