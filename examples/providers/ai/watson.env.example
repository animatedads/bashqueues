# Example IBM Watson/watsonx AI advisory provider configuration.
# This is a contract example only. No live Watson calls are implemented in 0.18.0.

QUEUEBASH_AI_PROVIDER="watson"
QUEUEBASH_AI_PROVIDER_HELPER="/usr/libexec/queuebash/providers/ai/queue-ai-ask-watson"
QUEUEBASH_AI_AUDIT_MODE="metadata"
QUEUEBASH_AI_AUDIT_FULL_PROMPTS=0
QUEUEBASH_AI_AUDIT_FULL_RESPONSES=0
QUEUEBASH_AI_AUDIT_LOG="/var/log/queuebash/ai-advisory.audit.jsonl"

# Context disclosure policy should normally be provider-resolved.
QUEUEBASH_AI_DEFAULT_CONTEXT="docs,commands,classes,providers"
QUEUEBASH_AI_ALLOW_QUEUE_STATUS=0
QUEUEBASH_AI_ALLOW_POLICY_DETAILS=0

# Secret material should be provided by a key/trust provider, not hard-coded here.
QUEUEBASH_AI_PROVIDER_KEY_REF="provider:keyvault:watson-api-key"
