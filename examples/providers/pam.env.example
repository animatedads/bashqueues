# PAM.d/NSS governance provider example for bashqueues.
# Install as: /etc/queuebash/policy/providers.d/pam.env

QUEUEBASH_PAM_PROVIDER=1
QUEUEBASH_PAM_SERVICE="queuebash"
QUEUEBASH_PAM_DEV_SERVICE="queuebash-dev"
QUEUEBASH_PAM_NSS_REQUIRED=1
QUEUEBASH_PAM_CACHE_DIR="/var/cache/queuebash/pam"
QUEUEBASH_PAM_CACHE_TTL_SECONDS=60

QUEUEBASH_PAM_HELPER_DIR="/usr/libexec/queuebash/providers/pam"
QUEUEBASH_PAM_ACCOUNT_HELPER="/usr/libexec/queuebash/providers/pam/queue-pam-account-check"
QUEUEBASH_PAM_SESSION_HELPER="/usr/libexec/queuebash/providers/pam/queue-pam-session-check"
QUEUEBASH_NSS_IDENTITY_HELPER="/usr/libexec/queuebash/providers/pam/queue-nss-identity-resolve"
QUEUEBASH_PAM_ACL_HELPER="/usr/libexec/queuebash/providers/pam/queue-pam-acl-check"
