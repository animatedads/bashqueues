# bashqueues cloud resource file-backed provider example
QUEUEBASH_CLOUD_RESOURCE_PROVIDER=file
QUEUEBASH_CLOUD_RESOURCE_REGISTRY=/var/lib/queuebash/cloud-resources
QUEUEBASH_CLOUD_RESOURCE_FAIL_CLOSED=1
QUEUEBASH_CLOUD_RESOURCE_STORE_SECRETS=0
QUEUEBASH_CLOUD_RESOURCE_REQUIRE_PROVENANCE=1
QUEUEBASH_CLOUD_RESOURCE_DEFAULT_LEASE_SECONDS=3600
