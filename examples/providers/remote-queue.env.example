# Example remote queue service provider configuration.
# Install target: /etc/queuebash/policy/providers.d/remote-queue.env
# This is a contract example only. It is not activated automatically.

QUEUE_REMOTE_PROVIDER=remote-queue
QUEUE_REMOTE_PROVIDER_SCHEMA=queuebash.remote_queue_service.v1

# Canonical helper/state/audit locations for a future provider implementation.
QUEUE_REMOTE_PROVIDER_HELPER_DIR=/usr/libexec/queuebash/providers/remote-queue
QUEUE_REMOTE_SESSION_ROOT=/var/lib/queuebash/remote-queue/sessions
QUEUE_REMOTE_AUDIT_LOG=/var/log/queuebash/remote-queue-audit.jsonl

# Secure defaults.
QUEUE_REMOTE_BIND=127.0.0.1
QUEUE_REMOTE_PUBLIC_BIND=0
QUEUE_REMOTE_REQUIRE_AUTH=1
QUEUE_REMOTE_REQUIRE_POLICY=1
QUEUE_REMOTE_FAIL_CLOSED=1
QUEUE_REMOTE_ALLOW_GENERIC_SHELL=0
QUEUE_REMOTE_ALLOW_HOST_PS=0
QUEUE_REMOTE_ALLOW_HOST_KILL=0
QUEUE_REMOTE_ALLOW_KILL_BY_NAME=0

# Operation allowlist. A real provider should resolve this through policy too.
QUEUE_REMOTE_ALLOWED_OPERATIONS="healthz session.create session.close workspace.upload workspace.download queue.submit queue.status queue.explain queue.tail queue.cancel dev.extract dev.symbols dev.flow dev.patch dev.splice dev.test process.ps process.kill audit.fetch"

# Bounded execution/log defaults.
QUEUE_REMOTE_MAX_RUNTIME_SECONDS=300
QUEUE_REMOTE_MAX_UPLOAD_BYTES=10485760
QUEUE_REMOTE_STDOUT_TAIL_BYTES=65536
QUEUE_REMOTE_STDERR_TAIL_BYTES=65536
QUEUE_REMOTE_SESSION_TTL_SECONDS=1800

# External policy helper contract. Output is JSON data only; never eval it as shell.
QUEUE_REMOTE_POLICY_HELPER=/usr/libexec/queuebash/providers/remote-queue/queue-remote-policy-check
