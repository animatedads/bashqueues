# queuebash LDAP ACL provider example
# Contract-only example for 0.18.13; no live LDAP helper is shipped here.
QUEUEBASH_ACL_PROVIDER=ldap_acl
QUEUEBASH_ACL_PROVIDER_KIND=ldap
QUEUEBASH_LDAP_URI=ldaps://ldap.example.com
QUEUEBASH_LDAP_BASE_DN=dc=example,dc=com
QUEUEBASH_LDAP_BIND_DN_FILE=/etc/queuebash/secrets/ldap-bind-dn
QUEUEBASH_LDAP_BIND_PASSWORD_FILE=/etc/queuebash/secrets/ldap-bind-password
QUEUEBASH_LDAP_GROUP_JOB_SUBMIT=cn=bashqueues-submitters,ou=groups,dc=example,dc=com
QUEUEBASH_ACL_FAIL_CLOSED=1
QUEUEBASH_ACL_CACHE_TTL_SECONDS=300
