# queuebash PAM/NSS identity provider example
# Contract-only example for 0.18.13; no live PAM/NSS helper is shipped here.
QUEUEBASH_IDENTITY_PROVIDER=pam_account
QUEUEBASH_IDENTITY_PROVIDER_KIND=pam_nss
QUEUEBASH_PAM_SERVICE=queuebash
QUEUEBASH_NSS_RESOLVE_GROUPS=1
QUEUEBASH_ACL_FAIL_CLOSED=1
QUEUEBASH_ACL_CACHE_TTL_SECONDS=120
QUEUEBASH_PAM_POLICY_FILE=/etc/queuebash/policy/acl.d/pam-nss.env
