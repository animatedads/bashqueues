# queuebash file-backed ACL provider example
# 0.18.15 implements this local provider for single-user/test systems.
# Providers supply normalized decisions; they never supply shell.

QUEUEBASH_ACL_PROVIDER=file
QUEUEBASH_FILE_ACL_POLICY=/etc/queuebash/policy/acl/file_acl.tsv
QUEUEBASH_FILE_ACL_DEFAULT=deny
QUEUEBASH_ACL_CACHE_TTL_SECONDS=0
