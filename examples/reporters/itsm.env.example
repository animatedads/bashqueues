# bashqueues ITSM reporter contract example
#
# 0.18.8 is contract/outbox only. It writes normalized JSONL events that
# future ServiceNow/Jira/Freshservice/Zendesk/BMC/ManageEngine helpers can
# consume. It does not create tickets by itself.

# Enable ITSM contract event emission.
QUEUEBASH_ITSM_ENABLED=0

# Optional comma-separated logical backends for future reporters.
QUEUEBASH_ITSM_BACKENDS="servicenow,jira"

# Events permitted to enter the ITSM contract outbox.
QUEUEBASH_ITSM_EVENTS="failed,policy_blocked,integrity_violation,ai_safety_alert,ai_policy_bypass_attempt,ai_self_harm_or_distress_alert,ai_coercion_alert,ai_abuse_alert,finops_anomaly,legal_event"

# Default priority recorded in contract events.
QUEUEBASH_ITSM_DEFAULT_PRIORITY="medium"

# Optional path override. Default: ~/.queuebash/logs/itsm-events.jsonl
# QUEUEBASH_ITSM_EVENT_LOG="/var/log/queuebash/itsm-events.jsonl"

# Bridge contract events into existing reporter plugins. Off by default because
# the contract outbox is the stable interface for 0.18.8.
QUEUEBASH_ITSM_BRIDGE_REPORTERS=0
