# bashqueues execution environment profile: staging
EXEC_ENV_NAME=staging
EXEC_ENV_LABEL="Staging / pre-production"
EXEC_ENV_CHROOT_MODE=off
EXEC_ENV_CHROOT_ROOT=""
EXEC_ENV_READONLY_ROOT=0
EXEC_ENV_WRITABLE_PATHS="/tmp,/var/tmp,/work"
EXEC_ENV_SECRET_SCOPE=staging
EXEC_ENV_ENDPOINT_SCOPE=staging
EXEC_ENV_DATA_SCOPE=staging
EXEC_ENV_CONFIRMATION_REQUIRED=0
