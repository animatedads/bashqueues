# bashqueues execution environment profile: live
EXEC_ENV_NAME=live
EXEC_ENV_LABEL="Production / live"
EXEC_ENV_CHROOT_MODE=off
EXEC_ENV_CHROOT_ROOT=""
EXEC_ENV_READONLY_ROOT=1
EXEC_ENV_WRITABLE_PATHS="/tmp,/var/tmp,/work"
EXEC_ENV_SECRET_SCOPE=live
EXEC_ENV_ENDPOINT_SCOPE=live
EXEC_ENV_DATA_SCOPE=live
EXEC_ENV_CONFIRMATION_REQUIRED=1
