# bashqueues execution environment profile: test
EXEC_ENV_NAME=test
EXEC_ENV_LABEL="Test / non-production"
EXEC_ENV_CHROOT_MODE=off
EXEC_ENV_CHROOT_ROOT=""
EXEC_ENV_READONLY_ROOT=0
EXEC_ENV_WRITABLE_PATHS="/tmp,/var/tmp,/work"
EXEC_ENV_SECRET_SCOPE=test
EXEC_ENV_ENDPOINT_SCOPE=test
EXEC_ENV_DATA_SCOPE=test
EXEC_ENV_CONFIRMATION_REQUIRED=0
