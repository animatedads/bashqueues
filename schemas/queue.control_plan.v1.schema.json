{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://queuebash.local/schemas/queue.control_plan.v1.schema.json",
  "title": "queue.control_plan.v1",
  "type": "object",
  "required": ["schema", "source", "plan", "analysis"],
  "properties": {
    "schema": { "const": "queue.control_plan.v1" },
    "source": {
      "type": "object",
      "required": ["adapter", "format", "path", "native"],
      "properties": {
        "adapter": { "type": "string" },
        "format": { "type": "string" },
        "path": { "type": "string" },
        "digest": { "type": "string" },
        "native": { "type": "boolean" },
        "confidence": { "type": "string", "enum": ["high", "medium", "low", "unknown"] }
      },
      "additionalProperties": true
    },
    "plan": {
      "type": "object",
      "properties": {
        "classes": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "restrictions": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "assets": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "gateways": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "identities": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "secrets": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "job_templates": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "workflows": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "dependencies": { "type": "array", "items": { "type": "object", "required": ["from", "to", "reason"], "properties": { "from": {"type":"string"}, "to": {"type":"string"}, "reason": {"type":"string"} }, "additionalProperties": true } },
        "approval_gates": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      },
      "additionalProperties": true
    },
    "analysis": {
      "type": "object",
      "properties": {
        "intent": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "unsupported": { "type": "array", "items": { "type": "string" } },
        "needs_review": { "type": "array", "items": { "type": "string" } },
        "unsafe_refused": { "type": "array", "items": { "type": "string" } },
        "safe_to_stage": { "type": "boolean" },
        "safe_to_apply": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
