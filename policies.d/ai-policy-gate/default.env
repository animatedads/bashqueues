# Optional AI policy gate defaults.
# Source this from your service wrapper, sentinel companion, or shell before
# invoking bin/queue-ai-policy-gate. The module is off unless explicitly enabled.
# The helper can also load this file with --config without shell evaluation.
QUEUEBASH_AI_POLICY_GATE_ENABLED=0
QUEUEBASH_AI_PROVIDER=ollama
QUEUEBASH_AI_MODEL=gemma4:e2b
QUEUEBASH_AI_POLICY_GATE_PROVIDER=ollama
QUEUEBASH_AI_POLICY_GATE_BLOCK_THRESHOLD=0.86
QUEUEBASH_AI_POLICY_GATE_DELAY_THRESHOLD=0.45
QUEUEBASH_AI_POLICY_GATE_DEFAULT_DELAY_SECONDS=900
QUEUEBASH_AI_POLICY_GATE_MAX_DELAY_SECONDS=3600
QUEUEBASH_AI_POLICY_GATE_MAX_COMMAND_CHARS=4096
QUEUEBASH_AI_POLICY_GATE_OLLAMA_URL=http://127.0.0.1:11434/api/generate
QUEUEBASH_AI_POLICY_GATE_TIMEOUT=45
# Keep unset/0. Setting this to 1 permits non-loopback URLs and is intentionally unsafe.
QUEUEBASH_AI_POLICY_GATE_ALLOW_NONLOCAL=0
# ITSM/ticket contract integration. Uses bashqueues ITSM JSONL outbox only when
# QUEUEBASH_ITSM_ENABLED=1 and the event is permitted by QUEUEBASH_ITSM_EVENTS.
# Bob21 never claims a live ticket was created; it records ticket_requested=true.
QUEUEBASH_AI_POLICY_GATE_TICKET_ON_POL_BLOCK=1
QUEUEBASH_AI_POLICY_GATE_TICKET_ON_ADVISE_DELAY=0
QUEUEBASH_AI_POLICY_GATE_ADVISORY_TICKET_SEVERITY=high

# Legal/case restriction hint checking is deterministic and local-only. Hints
# never execute SQL or query databases; they match bounded command/script text.
QUEUEBASH_AI_POLICY_GATE_LEGAL_CASE_HINTS_ENABLED=1
QUEUEBASH_AI_POLICY_GATE_LEGAL_CASE_HINTS_BUILTIN=1
# Optional TSV/pipe-delimited file: kind<TAB>id<TAB>severity<TAB>literal-or-regex:pattern
# QUEUEBASH_AI_POLICY_GATE_LEGAL_CASE_HINTS_FILE=/etc/queuebash/policies.d/legal-cases/restriction_hints.tsv
