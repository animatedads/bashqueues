# bashqueues AI profile: balanced
AI_PROFILE_NAME="balanced"
AI_CAPABILITIES="chat summarize classify json"
AI_PROVIDER_ORDER="openai_compat deepseek gemini anthropic mistral ollama"
AI_ROUTING_STRATEGY="highest_quality_within_budget"
AI_COST_STRATEGY="prefer_low_cost"
AI_MAX_COST_PER_REQUEST_GBP="0.05"
AI_MAX_COST_PER_JOB_GBP="0.25"
AI_MAX_LATENCY_SECONDS="60"
AI_ALLOW_CLOUD=1
AI_ALLOW_LOCAL=1
AI_REQUIRE_AUDIT=1
AI_FALLBACK_ENABLED=1
AI_HEALTH_REQUIRED=1
# Optional broker selection health gates. disabled_by_policy and disabled_by_cost remain hard skips even if allow-listed.
AI_ALLOWED_HEALTH_STATES="available healthy"
AI_BLOCKED_HEALTH_STATES=""
AI_BROKER_AUTO_HEALTH_FEEDBACK=1
AI_HEALTH_FAILURE_COOLDOWN_SECONDS=300
AI_REQUIRE_JSON_MODE=0
# Policy references included in broker explain/selection output when applicable.
# Format: ID|label|URI, separated by spaces or commas.
AI_REGULATORY_POLICY_REFS="UK_GDPR|UK GDPR data protection review|policy://regulatory/uk-gdpr EU_AI_ACT|EU AI Act applicability review|policy://regulatory/eu-ai-act"
AI_CORPORATE_POLICY_REFS="CORP_AI_USE|Corporate AI acceptable-use policy|policy://corporate/ai-use CORP_DATA_CLASSIFICATION|Corporate data classification policy|policy://corporate/data-classification"
AI_PRIVACY_POLICY_REFS="PII_REDACTION|PII redaction required before cloud AI|policy://privacy/pii-redaction"
AI_DATA_RESIDENCY_POLICY_REFS="DATA_RESIDENCY_REVIEW|Data residency review required for cloud providers|policy://data-residency/default"
AI_EXPORT_CONTROL_POLICY_REFS="EXPORT_CONTROL_REVIEW|Export-control/ITAR review before restricted content leaves boundary|policy://export-control/default"
AI_AUDIT_POLICY_REFS="AI_AUDIT_REQUIRED|AI broker request and selection audit required|policy://audit/ai-broker"
