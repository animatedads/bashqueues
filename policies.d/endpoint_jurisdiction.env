# bashqueues endpoint jurisdiction map
# Maps named endpoints/IP ranges to the cloud/legal region used by endpoint:* assets.
# The endpoint asset never guesses public geolocation from the internet.  Admins
# should maintain this map from CMDB, DNS, cloud inventory, or approved service catalogues.

# Exact host/IP mapping.  Key suffix is uppercased with non-alphanumerics changed to underscores.
# Example:
#   QUEUEBASH_ENDPOINT_REGION_API_UK_EXAMPLE_COM="uksouth"
#   QUEUEBASH_ENDPOINT_REGION_203_0_113_10="eu-west-2"

# Host suffix mapping.  Example: any host ending in .uk.example.com maps to uksouth.
#   QUEUEBASH_ENDPOINT_SUFFIX_REGION_UK_EXAMPLE_COM="uksouth"

# IPv4 CIDR mapping, one-based numeric keys.  Example:
#   QUEUEBASH_ENDPOINT_CIDR_REGION_1="203.0.113.0/24=eu-west-2"

# DNS resolution can be disabled globally for fully offline/CMDB-only operation.
QUEUEBASH_ENDPOINT_RESOLVE_DNS="1"

# Unknown private endpoints are blocked by default.  Set to 1 only if private DNS
# is governed elsewhere and private RFC1918 destinations are considered acceptable.
QUEUEBASH_ENDPOINT_ALLOW_PRIVATE_UNKNOWN="0"
