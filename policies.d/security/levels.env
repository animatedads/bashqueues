# bashqueues security classification profiles.
# Newline-delimited TSV values can be copied into CLASS_POLICY_MANDATORY_ASSETS
# or referenced by governance tooling.
LEVEL_OFFICIAL_ASSETS=$'audit\tstream_verified\tOfficial\trequire_remote=0'
LEVEL_SENSITIVE_ASSETS=$'audit\tstream_verified\tSensitive\trequire_remote=1\ncrypto\tvolume_encrypted\t${QUEUEBASH_DATA_DIR:-/data/work}\nnet\tegress_policy\tprivate-only'
LEVEL_CONFIDENTIAL_ASSETS=$'audit\tstream_verified\tConfidential\trequire_remote=1\ncrypto\tvolume_encrypted\t${QUEUEBASH_DATA_DIR:-/data/work}\nnet\tegress_policy\tdeny-all'
LEVEL_SECRET_ASSETS=$'audit\tstream_verified\tSecret\trequire_remote=1\ncrypto\tvolume_encrypted\t${QUEUEBASH_DATA_DIR:-/data/work}\nnet\tegress_policy\tdeny-all'
LEVEL_HIPAA_ASSETS=$'audit\tstream_verified\tHIPAA\trequire_remote=1\ncrypto\tvolume_encrypted\t${QUEUEBASH_DATA_DIR:-/data/work}\nnet\tegress_policy\tprivate-only'
LEVEL_PROTECTED_ASSETS=$'audit\tstream_verified\tProtected\trequire_remote=1\ncrypto\tvolume_encrypted\t${QUEUEBASH_DATA_DIR:-/data/work}\nnet\tegress_policy\tprivate-only'
