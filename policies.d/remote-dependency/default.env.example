# bashqueues remote dependency policy defaults
# Contract-first, fixture-first, no live remote mutation by default.

QUEUEBASH_REMOTE_DEPENDENCY_ENABLED=0
QUEUEBASH_REMOTE_DEPENDENCY_PROVIDER=fixture
QUEUEBASH_REMOTE_DEPENDENCY_PROVIDER_DIR="${QUEUEBASH_PROVIDER_DIR:-providers.d}/remote_dependency"
QUEUEBASH_REMOTE_DEPENDENCY_FIXTURE_DIR="${QUEUEBASH_TEST_FIXTURE_DIR:-tests/fixtures}/remote_dependency"

# Remote dependency resolution is a trusted-read gate.
QUEUEBASH_REMOTE_DEPENDENCY_REQUIRE_ACL=1
QUEUEBASH_REMOTE_DEPENDENCY_REQUIRE_SIGNATURE=1
QUEUEBASH_REMOTE_DEPENDENCY_REQUIRE_TRUSTED_SERVICE=1
QUEUEBASH_REMOTE_DEPENDENCY_MAX_FRESHNESS_SECONDS=300
QUEUEBASH_REMOTE_DEPENDENCY_DEFAULT_TIMEOUT_SECONDS=3600
QUEUEBASH_REMOTE_DEPENDENCY_DEFAULT_FAILURE_POLICY=block

# Explicitly forbidden in the default contract.
QUEUEBASH_REMOTE_DEPENDENCY_ALLOW_SSH=0
QUEUEBASH_REMOTE_DEPENDENCY_ALLOW_UNAUTHENTICATED_HTTP=0
QUEUEBASH_REMOTE_DEPENDENCY_ALLOW_WORKER_POLLING=0
QUEUEBASH_REMOTE_DEPENDENCY_ALLOW_REMOTE_MUTATION=0

# Future submit/explain integration should use waiting_remote when available.
QUEUEBASH_REMOTE_DEPENDENCY_WAIT_STATE=waiting_remote
