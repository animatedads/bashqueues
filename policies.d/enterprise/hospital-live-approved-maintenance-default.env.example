# queuebash enterprise profile: hospital live approved maintenance default
# This profile allows only tightly approved maintenance pilots, not broad live execution.
QUEUEBASH_ENTERPRISE_PROFILE="hospital-live-approved-maintenance-default"
QUEUEBASH_ENTERPRISE_PROFILE_SCHEMA="queuebash.enterprise_profile.v1"
QUEUEBASH_LIVE_CLEARANCE="approved-maintenance-only"
QUEUEBASH_POLICY_ROOT_MUST_BE_EXPLICIT="1"
QUEUEBASH_POLICY_ROOT_COMPATIBILITY_REQUIRED="1"

# Read-only actions remain allowed; maintenance execution requires explicit approval.
QUEUEBASH_ALLOWED_ACTIONS="status,list,show,explain,audit-read,report-read,backup-verify,preflight-readonly"
QUEUEBASH_APPROVAL_REQUIRED_ACTIONS="submit,run,worker-start,maintenance-execute,secret-deliver,break-glass-request,break-glass-approve"
QUEUEBASH_BLOCKED_ACTIONS="remote-mutation,cloud-destroy,policy-edit,class-edit,install-system,unapproved-secret-env,model-output-execution"

# Approved classes are examples; site policy must replace them with signed class statements.
QUEUEBASH_APPROVED_MAINTENANCE_CLASSES="HOSPITAL_BACKUP_VERIFY,HOSPITAL_DEPLOY_PREFLIGHT,HOSPITAL_APPROVED_PATCH_WINDOW"
QUEUEBASH_REQUIRE_CHANGE_TICKET="1"
QUEUEBASH_REQUIRE_DUAL_CONTROL="1"
QUEUEBASH_REQUIRE_SIGNED_APPROVAL="1"
QUEUEBASH_REQUIRE_ROLLBACK_PLAN="1"
QUEUEBASH_REQUIRE_MAINTENANCE_WINDOW="1"

# Secrets/break-glass posture.
QUEUEBASH_SECRET_DELIVERY="file"
QUEUEBASH_SECRET_ENV_ALLOWED="0"
QUEUEBASH_SECRET_DELIVERY_ALLOWED="approved-only"
QUEUEBASH_SECRET_BREAK_GLASS_ALLOWED="authorised-only"
QUEUEBASH_SECRET_BREAK_GLASS_TTL_SECONDS_MAX="900"
QUEUEBASH_SECRET_AUDIT_REDACTED="1"
QUEUEBASH_SECRET_VALUE_IN_JSON_ALLOWED="0"

# AI/provider posture.
QUEUEBASH_AI_EXTERNAL_PROVIDER_ALLOWED="0"
QUEUEBASH_AI_POLICY_GATE_MODE="local-advisory-or-block"
QUEUEBASH_AI_MODEL_OUTPUT_EXECUTION_ALLOWED="0"

# Runtime posture.
QUEUEBASH_DEFAULT_RUNTIME_CAPS="no-ptrace,no-debug,no-network-tools,no-secret-env"
QUEUEBASH_LOG_ROOT="/var/log/queuebash"
QUEUEBASH_AUDIT_LOG="/var/log/queuebash/audit.jsonl"
QUEUEBASH_SECRET_ROOT="/run/queuebash/secrets"
QUEUEBASH_VERIFICATION_COMMAND="queue enterprise validate-profile hospital-live-approved-maintenance-default --json"
