# queuebash enterprise profile: hospital live read-only default
# This profile is safe-mode documentation/policy example, not broad live clearance.
QUEUEBASH_ENTERPRISE_PROFILE="hospital-live-readonly-default"
QUEUEBASH_ENTERPRISE_PROFILE_SCHEMA="queuebash.enterprise_profile.v1"
QUEUEBASH_LIVE_CLEARANCE="readonly-only"
QUEUEBASH_POLICY_ROOT_MUST_BE_EXPLICIT="1"
QUEUEBASH_POLICY_ROOT_COMPATIBILITY_REQUIRED="1"

# Allowed action families.
QUEUEBASH_ALLOWED_ACTIONS="status,list,show,explain,audit-read,report-read,backup-verify,preflight-readonly"

# Broad live execution/mutation remains blocked.
QUEUEBASH_BLOCKED_ACTIONS="submit,run,worker-start,remote-mutation,cloud-apply,cloud-destroy,secret-deliver,break-glass-deliver,policy-edit,class-edit,install-system,service-write"
QUEUEBASH_APPROVAL_REQUIRED_ACTIONS=""

# Secrets posture.
QUEUEBASH_SECRET_DELIVERY="file"
QUEUEBASH_SECRET_ENV_ALLOWED="0"
QUEUEBASH_SECRET_DELIVERY_ALLOWED="0"
QUEUEBASH_SECRET_BREAK_GLASS_ALLOWED="0"
QUEUEBASH_SECRET_AUDIT_REDACTED="1"
QUEUEBASH_SECRET_VALUE_IN_JSON_ALLOWED="0"

# AI/provider posture.
QUEUEBASH_AI_EXTERNAL_PROVIDER_ALLOWED="0"
QUEUEBASH_AI_POLICY_GATE_MODE="local-advisory-only"
QUEUEBASH_AI_MODEL_OUTPUT_EXECUTION_ALLOWED="0"

# Runtime posture.
QUEUEBASH_DEFAULT_RUNTIME_CAPS="no-ptrace,no-debug,no-network-tools,no-secret-env"
QUEUEBASH_LOG_ROOT="/var/log/queuebash"
QUEUEBASH_AUDIT_LOG="/var/log/queuebash/audit.jsonl"
QUEUEBASH_SECRET_ROOT="/run/queuebash/secrets"
QUEUEBASH_VERIFICATION_COMMAND="queue enterprise verify-profile hospital-live-readonly-default --json"
