# queuebash enterprise default profile: small-team-dev-default
# Scope: trusted small-team development queue roots only. Not for regulated live service execution.
QUEUEBASH_ENTERPRISE_PROFILE="small-team-dev-default"
QUEUEBASH_ENTERPRISE_PROFILE_SCHEMA="queuebash.enterprise_policy_profile.v1"
QUEUEBASH_PROFILE_ENVIRONMENT="dev"
QUEUEBASH_PROFILE_LIVE_SERVICE="0"

# Allowed actions: local development inspection and bounded local test execution.
QUEUEBASH_ALLOWED_ACTIONS="status,list,show,explain,stats,workers,events-tail,submit-dev,run-dev,test-dev,dryrun"
QUEUEBASH_BLOCKED_ACTIONS="live-cloud-apply,prod-secret-deliver,break-glass-deliver,remote-mutation,policy-root-edit,regulated-data-export"
QUEUEBASH_APPROVAL_REQUIRED_ACTIONS="external-ai-provider,privileged-system-change,shared-policy-edit"

QUEUEBASH_LOG_LOCATION="\${QUEUEBASH_ROOT}/logs"
QUEUEBASH_SECRET_LOCATION="\${QUEUEBASH_ROOT}/secrets or local developer secret files; never commit secrets"
QUEUEBASH_AI_PROVIDER_POLICY="local_by_default; external providers require explicit opt-in"
QUEUEBASH_VERIFICATION_COMMAND="bash -n queuebash.sh && queue dev validate --quick --json"
