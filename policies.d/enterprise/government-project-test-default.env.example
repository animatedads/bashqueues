# queuebash enterprise default profile: government-project-test-default
# Scope: controlled test deployment for public-sector or government project environments.
QUEUEBASH_ENTERPRISE_PROFILE="government-project-test-default"
QUEUEBASH_ENTERPRISE_PROFILE_SCHEMA="queuebash.enterprise_policy_profile.v1"
QUEUEBASH_PROFILE_ENVIRONMENT="test"
QUEUEBASH_PROFILE_LIVE_SERVICE="0"

# Allowed actions: governed test orchestration, read-only reporting, deployment preflight, and audit validation.
QUEUEBASH_ALLOWED_ACTIONS="status,list,show,explain,stats,workers,events-tail,report-read,audit-read,backup-verify,deployment-preflight,submit-test,run-test"
QUEUEBASH_BLOCKED_ACTIONS="unapproved-prod-access,live-citizen-data-export,break-glass-deliver,remote-mutation,destructive-cloud-apply,policy-root-edit-without-approval"
QUEUEBASH_APPROVAL_REQUIRED_ACTIONS="external-ai-provider,secret-deliver,test-maintenance-change,shared-policy-edit,network-egress-change"

QUEUEBASH_LOG_LOCATION="/var/log/queuebash or approved test audit store"
QUEUEBASH_SECRET_LOCATION="/etc/queuebash/secrets or approved vault reference; no inline secrets"
QUEUEBASH_AI_PROVIDER_POLICY="local or approved test provider only; external providers require explicit opt-in and redaction"
QUEUEBASH_VERIFICATION_COMMAND="bash -n queuebash.sh && bash tests/enterprise_default_profiles_static.sh"
