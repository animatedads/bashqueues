# bashqueues code/plugin signing policy
# Modes:
#   off     - do not check code/plugin signatures
#   warn    - check signatures and log/list failures, but do not block execution
#   enforce - unsigned, modified, or untrusted plugins/code block execution/verification
QUEUEBASH_CODE_SIGNATURE_MODE="warn"
QUEUEBASH_PLUGIN_SIGNATURE_MODE="${QUEUEBASH_CODE_SIGNATURE_MODE}"

# Space- or comma-separated SHA256 fingerprints of trusted code-signing public keys.
# The installer appends the root public key here when it signs the installed tree.
QUEUEBASH_CODE_TRUSTED_PUBLIC_KEY_SHA256S=""
