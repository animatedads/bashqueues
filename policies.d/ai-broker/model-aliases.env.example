# bashqueues AI model aliases are governed policy aliases, not vendor model strings.
AI_ALIAS_claude_default_PROFILE="high_quality"
AI_ALIAS_claude_default_PROVIDER_PREFERENCE="anthropic openai_compat gemini"
AI_ALIAS_claude_default_ALLOW_FALLBACK=1

AI_ALIAS_gpt_default_PROFILE="balanced"
AI_ALIAS_gpt_default_PROVIDER_PREFERENCE="openai_compat openai deepseek gemini"
AI_ALIAS_gpt_default_ALLOW_FALLBACK=1

AI_ALIAS_local_default_PROFILE="private_only"
AI_ALIAS_local_default_PROVIDER_PREFERENCE="ollama openai_compat"
AI_ALIAS_local_default_ALLOW_FALLBACK=1

AI_ALIAS_json_default_PROFILE="json_strict"
AI_ALIAS_json_default_PROVIDER_PREFERENCE="openai_compat gemini anthropic deepseek mistral"
AI_ALIAS_json_default_ALLOW_FALLBACK=1
