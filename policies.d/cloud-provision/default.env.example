# bashqueues cloud provisioning contract defaults
# Contract/dry-run only in 0.18.37. Live apply is intentionally absent.
QUEUEBASH_CLOUD_PROVISION_TEMPLATES=/etc/bashqueues/policies.d/cloud-provision/templates.json
QUEUEBASH_CLOUD_PROVISION_APPROVAL_POLICY=/etc/bashqueues/policies.d/cloud-provision/approval-policy.json
QUEUEBASH_CLOUD_PROVISION_REQUIRE_CHANGE_TICKET=1
QUEUEBASH_CLOUD_PROVISION_STORE_SECRETS=0
QUEUEBASH_CLOUD_PROVISION_LIVE_APPLY_SUPPORTED=0
