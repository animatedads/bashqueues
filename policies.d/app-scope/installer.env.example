# queuebash embedded API application scope example: installer
QUEUEBASH_APP_SCOPE_NAME="installer"
QUEUEBASH_APP_ALLOW_OPS="ping version capabilities session.create session.list job.list job.status job.explain worker.once"
QUEUEBASH_APP_ALLOW_CLASSES="SYSTEM_INSTALL DEV_TEST_RUNNER"
QUEUEBASH_APP_ALLOW_ROOTS="/root/.queuebash"
QUEUEBASH_APP_DENY_OPS="remote.admin policy.edit secret.read key.management acl.mutation dev.patch dev.splice patchset.apply"
QUEUEBASH_APP_AUDIT=1
QUEUEBASH_APP_MAX_REQUEST_BYTES=65536
QUEUEBASH_APP_MAX_RESPONSE_BYTES=262144
QUEUEBASH_APP_REQUEST_TIMEOUT_SECONDS=10
