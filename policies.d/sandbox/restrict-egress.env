# bashqueues sandbox policy: restrict-egress
# Purpose: allow loopback/RFC1918 traffic while denying public egress.
QUEUEBASH_POLICY_KIND=sandbox
QUEUEBASH_POLICY_NAME=restrict-egress
SANDBOX_SYSTEMD_PROPERTIES=(
  "IPAddressAllow=10.0.0.0/8"
  "IPAddressAllow=172.16.0.0/12"
  "IPAddressAllow=192.168.0.0/16"
  "IPAddressAllow=127.0.0.0/8"
  "IPAddressAllow=::1/128"
  "IPAddressDeny=any"
)
SANDBOX_DIRECT_PREFIX=()
SANDBOX_DIRECT_WARNING="sandbox=restrict-egress requires systemd IPAddressAllow/IPAddressDeny; direct runner cannot enforce it"
