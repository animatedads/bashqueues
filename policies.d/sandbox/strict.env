# bashqueues sandbox policy: strict
# Purpose: private network, read-only host filesystem/home, no privilege escalation.
QUEUEBASH_POLICY_KIND=sandbox
QUEUEBASH_POLICY_NAME=strict
SANDBOX_SYSTEMD_PROPERTIES=(
  "PrivateNetwork=yes"
  "ProtectSystem=strict"
  "ProtectHome=read-only"
  "NoNewPrivileges=yes"
  "ReadWritePaths=/tmp $(_queue_root)/outputs ${QUEUEBASH_OUTPUT_ENV:-} ${QUEUEBASH_ENV_OUT:-}"
)
SANDBOX_DIRECT_PREFIX=(unshare --net -r --)
SANDBOX_DIRECT_WARNING="sandbox=strict direct fallback only isolates networking; filesystem protections require systemd"
