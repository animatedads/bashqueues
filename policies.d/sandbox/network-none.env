# bashqueues sandbox policy: network-none
# Purpose: isolate job in a private network namespace.
QUEUEBASH_POLICY_KIND=sandbox
QUEUEBASH_POLICY_NAME=network-none
SANDBOX_SYSTEMD_PROPERTIES=(
  "PrivateNetwork=yes"
)
SANDBOX_DIRECT_PREFIX=(unshare --net -r --)
SANDBOX_DIRECT_WARNING="sandbox=network-none requested but direct runner cannot find/enforce a usable network namespace fallback"
