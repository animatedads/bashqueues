# bashqueues sandbox policy: queue-default
# Purpose: safe default for general queue jobs; restrict public egress but keep local services reachable.
QUEUEBASH_POLICY_KIND=sandbox
QUEUEBASH_POLICY_NAME=queue-default
SANDBOX_SYSTEMD_PROPERTIES=(
  "IPAddressAllow=10.0.0.0/8"
  "IPAddressAllow=172.16.0.0/12"
  "IPAddressAllow=192.168.0.0/16"
  "IPAddressAllow=127.0.0.0/8"
  "IPAddressAllow=::1/128"
  "IPAddressDeny=any"
)
SANDBOX_DIRECT_PREFIX=()
SANDBOX_DIRECT_WARNING="sandbox=queue-default requires systemd IPAddressAllow/IPAddressDeny; direct runner cannot enforce it"
