# bashqueues IBM Cloud FinOps cache policy example
# Contract-only: a site collector or future queue job writes these local files.
# Worker preflight assets read them; workers must not call IBM Cloud APIs.

QUEUEBASH_IBM_FINOPS_CACHE=/etc/queuebash/finops/ibm_cost_cache.json
QUEUEBASH_IBM_FINOPS_HEALTH=/etc/queuebash/finops/ibm_finops.health
QUEUEBASH_IBM_FINOPS_MAX_AGE_SECONDS=86400
QUEUEBASH_IBM_FINOPS_COLLECTOR_CLASS=CLOUD_IBM_FINREG

# Example cache schema:
# {
#   "schema": "queuebash.ibm_finops_cache.v1",
#   "generated_at_epoch": 1790000000,
#   "provider": "ibm",
#   "region": "eu-gb",
#   "account_id_sha256": "...",
#   "spend": { "account": { "month": 123.45 } },
#   "budgets": { "ibm-finreg": { "remaining": 2500.00 } }
# }
