# bashqueues SNMP map: default
#
# This file centralises site-specific SNMP targets and OIDs so class files can
# refer to stable names instead of opaque numeric OIDs.  Install a site copy at:
#   /etc/bashqueues/snmp-map.env
# or:
#   /etc/bashqueues/snmp.d/default.env
#
# Entry format:
#   SNMP_MAP_<ALIAS>_TARGET="host-or-ip"
#   SNMP_MAP_<ALIAS>_OID=".1.3..."
# Optional defaults:
#   SNMP_MAP_<ALIAS>_COMM="public"
#   SNMP_MAP_<ALIAS>_V="2c"
#   SNMP_MAP_<ALIAS>_TIMEOUT="5"
#   SNMP_MAP_<ALIAS>_RETRIES="1"
#   SNMP_MAP_<ALIAS>_MIN="100"
#   SNMP_MAP_<ALIAS>_MAX="85"
#   SNMP_MAP_<ALIAS>_EXPECT_INT="1"
#   SNMP_MAP_<ALIAS>_EXPECT_STR="Active"
#   SNMP_MAP_<ALIAS>_MATCH="exact"
#
# Example aliases; keep values commented until adapted to the local NMS.
#SNMP_MAP_SAN_CPU_TARGET="10.0.0.5"
#SNMP_MAP_SAN_CPU_OID=".1.3.6.1.4.1.2021.11.9.0"
#SNMP_MAP_SAN_CPU_COMM="monitor"
#SNMP_MAP_SAN_CPU_V="2c"
#SNMP_MAP_SAN_CPU_MAX="85"
#
#SNMP_MAP_MAINT_WINDOW_TARGET="10.0.0.250"
#SNMP_MAP_MAINT_WINDOW_OID=".1.3.6.1.4.1.99999.10.1.0"
#SNMP_MAP_MAINT_WINDOW_COMM="monitor"
#SNMP_MAP_MAINT_WINDOW_EXPECT_INT="1"
