# bashqueues queue ask OpenAI provider example policy/env.
# Copy to a site-controlled policy location and point the service/user shell at it.
# Do not commit real API keys or place keys in command lines.

QUEUEBASH_AI_PROVIDER=openai
QUEUEBASH_AI_OPENAI_MODEL=gpt-4.1-mini
QUEUEBASH_AI_OPENAI_ENDPOINT=https://api.openai.com/v1/responses
QUEUEBASH_AI_OPENAI_TIMEOUT=60
QUEUEBASH_AI_OPENAI_MAX_OUTPUT_TOKENS=4096
QUEUEBASH_AI_OPENAI_TEMPERATURE=0.2

# Prefer a root-readable/user-readable secret file over environment inline secrets.
# QUEUEBASH_AI_OPENAI_API_KEY_FILE=/run/queuebash/secrets/openai_api_key

# Live calls are disabled unless explicitly enabled for the calling environment.
# QUEUEBASH_AI_LIVE_ENABLED=1
