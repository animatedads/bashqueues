# bashqueues OpenAI-compatible local/private ask provider example.
# Copy to an operator-managed policy/secrets location before live use.

QUEUEBASH_AI_OPENAI_COMPAT_ENDPOINT=http://127.0.0.1:8000/v1/chat/completions
QUEUEBASH_AI_OPENAI_COMPAT_MODEL=local-model
QUEUEBASH_AI_OPENAI_COMPAT_TIMEOUT=60
QUEUEBASH_AI_OPENAI_COMPAT_MAX_OUTPUT_TOKENS=4096
QUEUEBASH_AI_OPENAI_COMPAT_TEMPERATURE=0.2

# Optional: only set for private gateways requiring bearer auth.
# QUEUEBASH_AI_OPENAI_COMPAT_API_KEY_FILE=/etc/bashqueues/secrets/openai_compat.key
# QUEUEBASH_AI_OPENAI_COMPAT_API_KEY=
