# Groq ask provider policy example.
# Copy to local policy only when live Groq use is approved.

QUEUEBASH_AI_GROQ_MODEL=llama-3.3-70b-versatile
QUEUEBASH_AI_GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
QUEUEBASH_AI_GROQ_TIMEOUT=60
QUEUEBASH_AI_GROQ_MAX_OUTPUT_TOKENS=4096
QUEUEBASH_AI_GROQ_TEMPERATURE=0.2

# Prefer a root-readable secret file over exporting raw secrets.
# QUEUEBASH_AI_GROQ_API_KEY_FILE=/etc/bashqueues/secrets/groq-api-key
# QUEUEBASH_AI_GROQ_API_KEY=
# GROQ_API_KEY=
