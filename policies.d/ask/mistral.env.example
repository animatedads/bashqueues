# bashqueues Mistral AI ask-provider policy example
# Copy to an admin-controlled policy location and edit locally.

QUEUEBASH_AI_MISTRAL_ENDPOINT=https://api.mistral.ai/v1/chat/completions
QUEUEBASH_AI_MISTRAL_MODEL=mistral-small-latest
QUEUEBASH_AI_MISTRAL_TIMEOUT=60
QUEUEBASH_AI_MISTRAL_MAX_OUTPUT_TOKENS=4096
QUEUEBASH_AI_MISTRAL_TEMPERATURE=0.2
# Prefer a root/admin-readable secret file. Do not commit real keys.
# QUEUEBASH_AI_MISTRAL_API_KEY_FILE=/etc/bashqueues/secrets/mistral.key
