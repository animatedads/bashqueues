# IBM watsonx.ai queue ask provider policy example.
# Copy to a local policy location and edit. Do not commit real credentials.

QUEUEBASH_AI_WATSONX_MODEL=ibm/granite-3-8b-instruct
QUEUEBASH_AI_WATSONX_ENDPOINT=https://us-south.ml.cloud.ibm.com/ml/v1/text/generation
QUEUEBASH_AI_WATSONX_VERSION=2025-02-11
QUEUEBASH_AI_WATSONX_TIMEOUT=60
QUEUEBASH_AI_WATSONX_MAX_NEW_TOKENS=4096
QUEUEBASH_AI_WATSONX_TEMPERATURE=0.2

# Required for live calls:
# QUEUEBASH_AI_WATSONX_PROJECT_ID=

# Prefer file-backed secrets:
# QUEUEBASH_AI_WATSONX_API_KEY_FILE=/etc/bashqueues/secrets/watsonx-api-key
# or a pre-created bearer token:
# QUEUEBASH_AI_WATSONX_BEARER_TOKEN_FILE=/etc/bashqueues/secrets/watsonx-bearer-token

# Live use still requires explicit opt-in at invocation/runtime:
# QUEUEBASH_AI_LIVE_ENABLED=1
