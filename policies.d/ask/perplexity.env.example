# Perplexity Sonar ask-provider policy example.
# Copy to a site-local policy location before enabling live calls.

QUEUEBASH_AI_PERPLEXITY_MODEL=sonar-pro
QUEUEBASH_AI_PERPLEXITY_ENDPOINT=https://api.perplexity.ai/chat/completions
QUEUEBASH_AI_PERPLEXITY_TIMEOUT=60
QUEUEBASH_AI_PERPLEXITY_MAX_OUTPUT_TOKENS=4096
QUEUEBASH_AI_PERPLEXITY_TEMPERATURE=0.2

# Prefer a root-readable secret file over putting keys in shell history.
# QUEUEBASH_AI_PERPLEXITY_API_KEY_FILE=/etc/bashqueues/secrets/perplexity-api-key
# QUEUEBASH_AI_PERPLEXITY_API_KEY=
