# Baseten Model APIs ask-provider policy example.
# Copy to a site policy location and edit locally. Do not commit real keys.

QUEUEBASH_AI_BASETEN_MODEL="deepseek-ai/DeepSeek-V4-Pro"
QUEUEBASH_AI_BASETEN_ENDPOINT="https://inference.baseten.co/v1/chat/completions"
QUEUEBASH_AI_BASETEN_TIMEOUT=60
QUEUEBASH_AI_BASETEN_MAX_OUTPUT_TOKENS=4096
QUEUEBASH_AI_BASETEN_TEMPERATURE=0.2

# Prefer a root-owned secret file for live use.
# QUEUEBASH_AI_BASETEN_API_KEY_FILE="/etc/bashqueues/secrets/baseten-api-key"
# QUEUEBASH_AI_BASETEN_API_KEY=""

# Live calls still require QUEUEBASH_AI_LIVE_ENABLED=1 at execution time.
