# Optional Anthropic queue ask provider configuration.
# Copy to a local policy/env location and edit. Do not commit real keys.

QUEUEBASH_AI_ANTHROPIC_MODEL=claude-sonnet-4-20250514
QUEUEBASH_AI_ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1/messages
QUEUEBASH_AI_ANTHROPIC_VERSION=2023-06-01
QUEUEBASH_AI_ANTHROPIC_TIMEOUT=60
QUEUEBASH_AI_ANTHROPIC_MAX_OUTPUT_TOKENS=4096
QUEUEBASH_AI_ANTHROPIC_TEMPERATURE=0.2

# Preferred secret form for service installs:
# QUEUEBASH_AI_ANTHROPIC_API_KEY_FILE=/etc/bashqueues/secrets/anthropic-api-key

# Alternate environment forms for interactive testing only:
# QUEUEBASH_AI_ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY=
