# bashqueues legal framework definitions (multi-cloud)
# Maps compliance frameworks to provider-specific cloud regions.

LEGAL_FRAMEWORK_GDPR_REGIONS="eu-central-1,eu-west-3,eu-west-1,eu-west-2,europe-west3,europe-west9,europe-west1,europe-west2,germanywestcentral,francecentral,westeurope,northeurope,uksouth"
LEGAL_FRAMEWORK_HIPAA_REGIONS="us-east-1,us-west-2,us-east4,us-central1,eastus,westus2"
LEGAL_FRAMEWORK_ITAR_REGIONS="us-gov-west-1,us-gov-east-1,usgovvirginia,usgovarizona"
LEGAL_FRAMEWORK_UK_DPA_REGIONS="eu-west-2,europe-west2,uksouth,ukwest"

# Trade-bloc / continental permitted-region groupings. These are policy aliases,
# not blanket legal conclusions; local/sector law may be stricter.
LEGAL_FRAMEWORK_CPTPP_REGIONS="ap-southeast-2,ap-northeast-1,ca-central-1,australia-southeast1,asia-northeast1,canadacentral,japaneast,australiaeast"
LEGAL_FRAMEWORK_CPTPP_MODE="trade_bloc_permitted"
LEGAL_FRAMEWORK_AU_REGIONS="af-south-1,southafricanorth,southafricawest"
LEGAL_FRAMEWORK_AFCFTA_REGIONS="af-south-1,southafricanorth,southafricawest"
LEGAL_FRAMEWORK_AU_MODE="continental_permitted"
LEGAL_FRAMEWORK_AFCFTA_MODE="continental_permitted"
