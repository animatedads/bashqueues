# bashqueues IBM Cloud sovereignty policy example
# Copy into /etc/queuebash/policies.d/sovereign/ibm.env or ~/.queuebash/policies.d/sovereign/ibm.env and adapt.

QUEUEBASH_CLOUD_PROVIDER=ibm
QUEUEBASH_IBM_REGION=eu-gb
QUEUEBASH_IBM_ACCOUNT_ID=""
QUEUEBASH_IBM_RESOURCE_GROUP=""
QUEUEBASH_IBM_AUTH_REQUIRED=1

# Region groups used by assets.d/ibm_identity.sh.
QUEUEBASH_IBM_GDPR_REGIONS="eu-de,eu-gb,eu-es"
QUEUEBASH_IBM_UK_DPA_REGIONS="eu-gb"
QUEUEBASH_IBM_FINREG_REGIONS="us-south,us-east,ca-tor,eu-de,eu-gb,eu-es,au-syd,jp-tok,jp-osa,br-sao"
