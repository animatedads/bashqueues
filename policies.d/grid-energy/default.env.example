# bashqueues grid-energy policy defaults
# Copy to /etc/queuebash/policies.d/grid-energy/default.env and edit.

QUEUEBASH_GRID_ENERGY_CACHE_DIR=/var/cache/bashqueues/grid-energy
QUEUEBASH_GRID_ENERGY_MAX_AGE_SECONDS=900
QUEUEBASH_GRID_ENERGY_DEFAULT_MAX_PRICE_PER_KWH=0.15
QUEUEBASH_GRID_ENERGY_DEFAULT_MAX_CARBON_GCO2_KWH=150

# Explicitly keep worker preflight fixture/cache-only by default.
QUEUEBASH_GRID_ENERGY_LIVE_API_ENABLED=0
QUEUEBASH_GRID_ENERGY_OT_WRITE_ENABLED=0
