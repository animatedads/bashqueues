# bashqueues remote queue management listener policy
# Copy to /etc/bashqueues/policies.d/remote-queue/remote-management.env and edit.
# The listener is opt-in and should normally bind to loopback behind SSH/mTLS/VPN.

QUEUE_REMOTE_MANAGEMENT_HOST=127.0.0.1
QUEUE_REMOTE_MANAGEMENT_PORT=8765
QUEUE_REMOTE_MANAGEMENT_ENDPOINT=/remote-queue
QUEUE_REMOTE_MANAGEMENT_LOOPBACK_ONLY=1

# Installed queue source and queue root used by the management service.
QUEUE_REMOTE_MANAGEMENT_QUEUEBASH_SOURCE=/usr/local/share/bashqueues/queuebash.sh
QUEUE_REMOTE_MANAGEMENT_QUEUE_ROOT=/var/lib/queuebash/remote-queue-root

# Client registry and remote-management ACL. Both are fail-closed.
QUEUE_REMOTE_MANAGEMENT_CLIENTS_FILE=/etc/bashqueues/policies.d/remote-queue/clients.tsv
QUEUE_REMOTE_MANAGEMENT_ACL_FILE=/etc/bashqueues/policies.d/remote-queue/acl.tsv

# State/audit. Audit contains no secrets/full payload dumps by default.
QUEUE_REMOTE_MANAGEMENT_STATE_DIR=/var/lib/queuebash/remote-queue-management
QUEUE_REMOTE_MANAGEMENT_AUDIT_LOG=/var/log/queuebash/remote-queue-management-audit.jsonl

# Bounding controls.
QUEUE_REMOTE_MANAGEMENT_MAX_RUNTIME_SECONDS=20
QUEUE_REMOTE_MANAGEMENT_MAX_BODY_BYTES=65536
QUEUE_REMOTE_MANAGEMENT_MAX_STDOUT_BYTES=65536
QUEUE_REMOTE_MANAGEMENT_MAX_STDERR_BYTES=32768
QUEUE_REMOTE_MANAGEMENT_ACCESS_LOG=0
