# IBM Cloud FinOps policy defaults
# Override per-deployment as required.

# Maximum age of local IBM FinOps cost cache before ibm_finops:cost_cache_fresh blocks
QUEUEBASH_IBM_FINOPS_MAX_CACHE_AGE=86400

# Minimum budget remaining (USD) before ibm_finops:budget_remaining blocks
QUEUEBASH_IBM_FINOPS_MIN_REMAINING=1

# Anomaly severity level that blocks: ok / warn / error / critical
QUEUEBASH_IBM_FINOPS_ANOMALY_BLOCK_LEVEL=error
