# IBM Cloud identity policy defaults
# Override per-deployment as required.

# Preferred auth method for platform workloads: trusted_profile, service_id, or iam_token
QUEUEBASH_IBM_AUTH_METHOD=trusted_profile

# IAM token max age in seconds before the asset gate requires re-auth
QUEUEBASH_IBM_TOKEN_MAX_AGE=3600

# Require auth to be active before any IBM Cloud class job runs
QUEUEBASH_IBM_AUTH_REQUIRED=1
