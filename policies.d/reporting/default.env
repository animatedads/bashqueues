# bashqueues reporting policy defaults
#
# Reporting is plugin based.  Reporter plugins live in reporters.d and observe
# events written by _queue_log_event.  No reporter fires unless explicitly
# configured here, in /etc/bashqueues/reporting.env, or in a queue-local
# policies.d/reporting/default.env.

QUEUEBASH_REPORTING_DISABLE=0

# SNMP INFORM reporter: disabled until both destination and community are set.
# QUEUEBASH_REPORTERS="snmp"
# QUEUEBASH_SNMP_INFORM_DEST="10.0.0.250:162"
# QUEUEBASH_SNMP_COMMUNITY="secure-alerts"
# QUEUEBASH_SNMP_TRAP_OID=".1.3.6.1.4.1.99999.1"
# QUEUEBASH_SNMP_INFORM_EVENTS="pol_blocked,failed,runtime_cap_violation,log_overflow_kill"

# Microsoft Notify reporter: disabled until QUEUEBASH_REPORTERS includes ms
# and endpoint/tenant/client credentials are configured.
# QUEUEBASH_REPORTERS="snmp,ms"
# QUEUEBASH_MS_ENDPOINT="https://example.ingest.monitor.azure.com/..."
# QUEUEBASH_MS_TENANT="00000000-0000-0000-0000-000000000000"
# QUEUEBASH_MS_CLIENT_ID="00000000-0000-0000-0000-000000000000"
# QUEUEBASH_MS_CLIENT_SECRET_FILE="/etc/bashqueues/secrets/ms-client-secret"
# QUEUEBASH_MS_SCOPE="https://management.azure.com/.default"
# QUEUEBASH_MS_TABLE="QueuebashEvent"
# QUEUEBASH_MS_EVENTS="failed,pol_blocked,runtime_cap_violation,log_overflow_kill"
# QUEUEBASH_MS_TIMEOUT=5

# Prometheus textfile reporter: disabled until QUEUEBASH_REPORTERS includes prom
# and QUEUEBASH_PROM_DIR points at a node-exporter textfile directory.
# QUEUEBASH_REPORTERS="snmp,ms,prom"
# QUEUEBASH_PROM_DIR="/var/lib/prometheus/node-exporter"
# QUEUEBASH_PROM_EVENTS="failed,pol_blocked,runtime_cap_violation,log_overflow_kill"
