# bashqueues class policy statement: default
# Central governance for user-selectable class security policies and exception overlays.
QUEUEBASH_POLICY_KIND=class-statement
QUEUEBASH_POLICY_NAME=default

# What normal users may select on submit/class paths.
CLASS_POLICY_USER_SANDBOX_POLICIES="off network-none restrict-egress strict queue-default"
CLASS_POLICY_USER_SECCOMP_POLICIES="off docker-default strict queue-default"

# Job-local exception overlays must be explicit and auditable.
# Supported modes: none, reason, authorisation, reason-or-authorisation.
CLASS_POLICY_EXCEPTION_FLAGS_REQUIRE="reason-or-authorisation"
CLASS_POLICY_WEAK_POLICY_REQUIRE="reason-or-authorisation"

# Selecting these weak policies directly is allowed, but must be justified.
CLASS_POLICY_SANDBOX_REASON_REQUIRED="off"
CLASS_POLICY_SECCOMP_REASON_REQUIRED="off"


# Per-user standing grants.
# These let the shared/admin policy delegate narrow security exceptions to specific
# queue users without requiring a per-command authorisation each time.  Values are
# space or comma separated.  User names are upper-cased and non-alphanumerics become
# underscores in variable names.
#
# Examples:
#   CLASS_POLICY_USER_WEBADMINS_ALLOW_ADD_PORTS="80 1080 8080"
#   CLASS_POLICY_USER_WEBADMINS_ALLOW_DROP_CAPS="only-port"
#   CLASS_POLICY_USER_DBA_ALLOW_ADD_PORTS=""
#
# Command-specific grants add COMMAND_<sha256-or-first16> between the user and grant:
#   CLASS_POLICY_USER_WEBADMINS_COMMAND_0123456789ABCDEF_ALLOW_ADD_PORTS="8080"
#
# Supported grant suffixes:
#   ALLOW_SANDBOX_OVERRIDES   e.g. off network-none
#   ALLOW_SECCOMP_ALLOWS      e.g. @debug
#   ALLOW_DROP_CAPS           e.g. no-network-tools only-port
#   ALLOW_ADD_PORTS           e.g. 80 1080 8080
#   ALLOW_SANDBOX_POLICIES    e.g. off
#   ALLOW_SECCOMP_POLICIES    e.g. off


# Emergency command policy blocks.  These are intended for rapid response to a
# zero-hour exploit or unsafe tool discovered after jobs/cron entries already
# exist.  The worker checks these before claims/preflight/payload launch.
#
# Exact command hash blocks are the safest and preferred form:
#   CLASS_POLICY_BLOCK_COMMAND_HASHES="0123456789abcdef..."
#
# Word/name blocks match argv[0] or basename(argv[0]), case-insensitively:
#   CLASS_POLICY_BLOCK_COMMAND_WORDS="exiftool vulnerable-tool"
#
# Pattern blocks match the shell-escaped command string using shell globs.  Use
# sparingly; hashes are more precise.
#   CLASS_POLICY_BLOCK_COMMAND_PATTERNS="*exiftool*;*vulnerable --mode*"
#
# Blocked commands require a command-bound authorisation by default.
CLASS_POLICY_BLOCK_COMMAND_HASHES=""
CLASS_POLICY_BLOCK_COMMAND_WORDS=""
CLASS_POLICY_BLOCK_COMMAND_PATTERNS=""
CLASS_POLICY_BLOCK_COMMAND_REQUIRE="authorisation"

# Cron bridge governance. If a crontab requests a weaker explicit class than
# these minima, the ticker requires a command-bound authorisation code; without
# a valid code it falls back to the generated safe cron class.
CLASS_POLICY_CRON_MIN_SANDBOX_LEVEL="strict"
CLASS_POLICY_CRON_MIN_SECCOMP_PROFILE="off"
CLASS_POLICY_CRON_DEFAULT_ON_AUTH_FAILURE="generated"

# Signed authorisations.
# Modes:
#   off             - legacy command-hash authorisations only
#   if-trusted-key - require a valid signature when this policy declares a public key for AUTHORISATION_ADMIN
#   always         - require a valid signature and a policy-declared public key
CLASS_POLICY_AUTHORISATION_SIGNATURE_REQUIRED="if-trusted-key"

# Trusted authorisation signing public keys are deliberately empty in the bundled
# default.  A site policy under /etc/bashqueues/policies.d/class-statement/default.env
# can make this read-only and fill these per-admin entries. Generate values with:
#   queue keygen authorisation root
#   queue keygen authorisation hc3
# Example variable names:
#   CLASS_POLICY_AUTHORISATION_SIGNER_ROOT_PUBLIC_KEY_SHA256="..."
#   CLASS_POLICY_AUTHORISATION_SIGNER_ROOT_PUBLIC_KEY_PEM_B64="..."
#   CLASS_POLICY_AUTHORISATION_SIGNER_HC3_PUBLIC_KEY_SHA256="..."
#   CLASS_POLICY_AUTHORISATION_SIGNER_HC3_PUBLIC_KEY_PEM_B64="..."

# Mandatory policy assets.
# These checks are evaluated for every job after class assets and are deliberately
# NOT bypassable with queue exception overlays. Use this for organisation-wide
# compliance checks that must apply regardless of the selected class.
#
# Format: newline-delimited TSV records in CLASS_POLICY_MANDATORY_ASSETS:
#   family<TAB>check<TAB>target<TAB>optional key=value params
#
# Example:
#   CLASS_POLICY_MANDATORY_ASSETS=$'path\texists\t/etc/queuebash/maintenance.ok\nsecaudit\tstring_safe\t${COMMAND_TEXT}'
CLASS_POLICY_MANDATORY_ASSETS=""
