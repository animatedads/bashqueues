# bashqueues seccomp policy: docker-default
# Docker-style syscall blacklist using systemd syscall groups.
QUEUEBASH_POLICY_KIND=seccomp
QUEUEBASH_POLICY_NAME=docker-default
SECCOMP_SYSTEMD_PROPERTIES=(
  "SystemCallArchitectures=native"
  "SystemCallFilter=~@clock @debug @module @mount @obsolete @privileged @raw-io @reboot @swap @cpu-emulation @keyring"
)
