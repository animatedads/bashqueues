# bashqueues seccomp policy: queue-default
# Purpose: Docker-style default syscall blacklist for normal queue jobs.
QUEUEBASH_POLICY_KIND=seccomp
QUEUEBASH_POLICY_NAME=queue-default
SECCOMP_SYSTEMD_PROPERTIES=(
  "SystemCallArchitectures=native"
  "SystemCallFilter=~@clock @debug @module @mount @obsolete @privileged @raw-io @reboot @swap @cpu-emulation @keyring"
)
