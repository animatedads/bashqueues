# bashqueues class: MOBILE_LOCAL_ONLY
# Purpose: Confidential local-only mobile jobs. No egress permitted.
CLASS_ALLOW_PARALLEL=0
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto
CLASS_DEFAULT_SANDBOX_LEVEL=strict
CLASS_DEFAULT_CPU_LIMIT=5
CLASS_DEFAULT_MEMORY_LIMIT=64M
CLASS_EGRESS_ALLOWED_JURISDICTION=NONE
CLASS_EGRESS_REQUIRE_ENCRYPTION=1
CLASS_RESULT_RETENTION_DAYS=1
CLASS_IS_DESTRUCTIVE=0
CLASS_NO_NETWORK=1
