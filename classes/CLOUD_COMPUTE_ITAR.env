# bashqueues class: CLOUD_COMPUTE_ITAR
# Purpose: restricted defence/export-controlled cloud compute. Compliance over cost.

CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=2
CLASS_DEFAULT_RUNNER=systemd
CLASS_DEFAULT_SANDBOX_LEVEL=strict
CLASS_DEFAULT_RUNTIME_CAPS="no-network-tools,no-spawn-shell"

queue_class_shared_asset sovereign framework_allowed "ITAR"
