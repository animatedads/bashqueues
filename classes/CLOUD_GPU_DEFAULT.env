# bashqueues class: CLOUD_GPU_DEFAULT
# Purpose: Example GPU cloud workload posture class. Contract/template only.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=2
CLASS_DEFAULT_RUNNER=auto

queue_class_shared_asset gpu_cloud provider approved required=1
queue_class_shared_asset gpu_cloud accelerator mapped required=1
queue_class_shared_asset gpu_cloud legal status=mapped_pending_validation
queue_class_shared_asset gpu_cloud audit logging required=1
