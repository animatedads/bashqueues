# bashqueues class: CLOUD_EU_SOVEREIGN_GDPR
# Purpose: Example GDPR/data-protection posture class for EU sovereign providers.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto

queue_class_shared_asset eu_sovereign legal framework=GDPR retention_evidence=1 deletion_evidence=1
queue_class_shared_asset eu_sovereign storage signed_url_redaction=1
queue_class_shared_asset eu_sovereign audit logging required=1
queue_class_shared_asset eu_sovereign region cross_border_review=required
