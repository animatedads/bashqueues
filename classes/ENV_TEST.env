# bashqueues class: ENV_TEST
# Purpose: run jobs in the test execution environment profile.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=0
CLASS_DEFAULT_RUNNER=auto
CLASS_DEFAULT_SANDBOX_LEVEL=strict
CLASS_DEFAULT_RUNTIME_CAPS=no-spawn-shell,no-network-tools,only-local-sockets
CLASS_EXEC_ENV=test
queue_class_shared_asset env profile_required test
queue_class_shared_asset env secret_scope test profile=test
queue_class_shared_asset env endpoint_scope test profile=test
