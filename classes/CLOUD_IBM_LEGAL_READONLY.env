# bashqueues class: CLOUD_IBM_LEGAL_READONLY
# Purpose: IBM Cloud legal read-only rail; no destructive effects.

CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=5
CLASS_DEFAULT_RUNNER=systemd
CLASS_DEFAULT_SANDBOX_LEVEL=restrict-egress
CLASS_DEFAULT_SECCOMP_PROFILE=docker-default
CLASS_DEFAULT_RUNTIME_CAPS="no-spawn-shell,no-network-tools"

QUEUEBASH_CLOUD_PROVIDER=ibm
QUEUEBASH_IBM_AUTH_REQUIRED=1
QUEUEBASH_LEGAL_EFFECT=readonly

queue_class_shared_asset ibm_identity auth_active _
queue_class_shared_asset ibm_identity target_region_allowed LEGAL
queue_class_shared_asset legal retention_respected dataset:legal-case effect=readonly registry_file=/etc/queuebash/legal_registry.tsv
queue_class_shared_asset legal jurisdiction_allowed dataset:legal-case worker_jurisdiction=LEGAL registry_file=/etc/queuebash/legal_registry.tsv
