# bashqueues class: CLOUD_RESOURCE_GDPR
# Purpose: example cloud resource class using provider-neutral resource availability.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=0
CLASS_DEFAULT_RUNNER=auto

queue_class_shared_asset cloud_resource available oci type=vm region=uk-london-1 compliance=gdpr class=CLOUD_RESOURCE_GDPR min_cpu=4 min_mem_gb=16
queue_class_shared_asset sovereign framework_allowed gdpr region=uk-london-1
queue_class_shared_asset finops anomaly_free cloud-resource block_on=error missing=ok
