# bashqueues class: CLOUD_EDGE_HIGH_ASSURANCE
# Purpose: High-assurance edge workload template with cache/log/legal controls.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto
queue_class_shared_asset edge_cloud provider any required=1
queue_class_shared_asset edge_cloud identity token_not_stored=1 required=1
queue_class_shared_asset edge_cloud storage signed_url_redaction=1 cache_log_pointers_only=1
queue_class_shared_asset edge_cloud legal framework=GDPR retention_evidence=1 deletion_evidence=1
queue_class_shared_asset edge_cloud network ingress=managed egress=restricted
