# bashqueues class: SECURITY_CONFIDENTIAL
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=0
CLASS_DEFAULT_RUNNER=systemd
CLASS_DEFAULT_SANDBOX_LEVEL=strict
CLASS_DEFAULT_RUNTIME_CAPS="no-network-tools,no-spawn-shell,only-local-sockets"
queue_class_shared_asset audit stream_verified "Confidential" require_remote=1
queue_class_shared_asset crypto volume_encrypted "${QUEUEBASH_DATA_DIR:-/data/work}"
queue_class_shared_asset net egress_policy "deny-all"
