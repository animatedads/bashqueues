# bashqueues class: CLOUD_EU_SOVEREIGN_HIGH_ASSURANCE
# Purpose: High-assurance EU sovereign provider template. Contract/example only.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto

queue_class_shared_asset eu_sovereign provider allowlist=ovhcloud,scaleway,hetzner,otc required=1
queue_class_shared_asset eu_sovereign identity service_identity required=1
queue_class_shared_asset eu_sovereign network restricted_egress=1 required=1
queue_class_shared_asset eu_sovereign legal framework=GDPR primary_source_validation=required
queue_class_shared_asset integrity manifest verified=1
queue_class_shared_asset secaudit logging required=1
