# bashqueues class: DB_MIGRATION
#
# Purpose:
#   Database schema migrations, data migrations, and ETL loads that modify
#   live database state. Strict serialisation — only one migration at a time,
#   system-wide. Audited, sandboxed, snapshot-before-run pattern encouraged.
#
# Design principles:
#   - Never run two migrations simultaneously (global exclusive claim).
#   - Require the target database to be reachable before dispatch.
#   - Require minimum free disk for rollback logs.
#   - No network egress during migration (prevents data exfiltration patterns).
#   - Prefer off-hours but allow daytime with exception overlay.
#
# Site overrides (export before sourcing):
#   QUEUEBASH_MIGRATION_DB_HOST  - database host:port (default localhost:5432/postgres)
#   QUEUEBASH_MIGRATION_DB_USER  - database user (default postgres)
#   QUEUEBASH_MIGRATION_LOG_DIR  - migration log directory (default /var/log/db-migrations)
#
# Override model:
#   Use queue exception add <qid> time:window --reason "..." for emergency
#   daytime migrations. Attach an authorisation code for production environments.

CLASS_ALLOW_PARALLEL=0
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=systemd
CLASS_DEFAULT_SANDBOX_LEVEL=network-none
CLASS_DEFAULT_SECCOMP_PROFILE=docker-default
CLASS_DEFAULT_TIMEOUT=2h
CLASS_DEFAULT_KILL_AFTER=30s
CLASS_DEFAULT_MAX_LOG_SIZE_BYTES=104857600
CLASS_DEFAULT_LOG_OVERFLOW_POLICY=stderr-only

# Absolute serialisation. No two migrations anywhere on this host simultaneously.
queue_class_exclusive_claim "db:migration:global"

# Scheduling: migrations run off-hours by default.
queue_class_shared_asset time window "migration-window" \
  weekdays=mon-fri \
  weekday_windows=20:00-05:00 \
  weekends=sat-sun \
  weekend_windows=00:00-12:00

# Database must be reachable before we try to migrate it.
queue_class_shared_asset db postgres_connect \
  "${QUEUEBASH_MIGRATION_DB_HOST:-localhost:5432/postgres}" \
  user="${QUEUEBASH_MIGRATION_DB_USER:-postgres}" \
  timeout=10

# Require free disk for WAL and rollback logs.
queue_class_shared_asset path freespace \
  "${QUEUEBASH_MIGRATION_LOG_DIR:-/var/log/db-migrations}" min_mb=500

# System must not be under load — migrations during high CPU can cause lock timeouts.
queue_class_shared_asset sys cpu_load "system" max_load_1m=4.0
queue_class_shared_asset sys memory_available "system" min_gb=1

# Do not run if a previous migration is still running.
queue_class_shared_asset queue job_has_not_run "migration" \
  field=name \
  match=substr \
  time=30m \
  states=running
