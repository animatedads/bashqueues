# bashqueues class: CLOUD_AWS_ITAR
CLASS_ALLOW_PARALLEL=0
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto
queue_class_shared_asset aws region_allowed "us-gov-west-1"
queue_class_shared_asset cloud_resource available aws type=vm compliance=itar min_cpu=2 min_mem_gb=8 class=CLOUD_AWS_ITAR
queue_class_shared_asset aws finops_budget_ok itar policy_file=policies.d/aws/cost-policy.example.json expected_hourly_usd=0.12
