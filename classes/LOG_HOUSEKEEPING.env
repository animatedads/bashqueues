# bashqueues class: LOG_HOUSEKEEPING
#
# Purpose:
#   Log rotation, compression, archival, and purge jobs. Lightweight version
#   of QUEUE_MAINTENANCE for non-queue log directories. Runs deep overnight,
#   serialised, with destructive operation guards.
#
# Design:
#   allow_rm=1 is intentional: log purge jobs need to delete old files.
#   The no_network_c2 and no_obfuscation checks remain active to prevent
#   a log cleanup script from being used as a persistence mechanism.
#
# Site overrides:
#   QUEUEBASH_LOG_HOUSEKEEPING_DIR  - log directory to clean (default /var/log)

CLASS_ALLOW_PARALLEL=0
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto
CLASS_DEFAULT_SANDBOX_LEVEL=network-none
CLASS_DEFAULT_TIMEOUT=2h
CLASS_DEFAULT_KILL_AFTER=30s
CLASS_DEFAULT_MAX_LOG_SIZE_BYTES=10485760

queue_class_exclusive_claim "log:housekeeping:slot"

queue_class_shared_asset secaudit no_network_c2 \
  "${QUEUEBASH_LOG_HOUSEKEEPING_SCRIPT:-/opt/scripts/log-clean.sh}"
queue_class_shared_asset secaudit no_obfuscation \
  "${QUEUEBASH_LOG_HOUSEKEEPING_SCRIPT:-/opt/scripts/log-clean.sh}"

queue_class_shared_asset path freespace \
  "${QUEUEBASH_LOG_HOUSEKEEPING_DIR:-/var/log}" min_mb=50

queue_class_shared_asset sys iowait "system" max_percent=40

queue_class_shared_asset time window "housekeeping-window" \
  weekdays=mon-fri \
  weekday_windows=02:00-05:00 \
  weekends=sat-sun \
  weekend_windows=02:00-08:00
