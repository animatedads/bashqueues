# bashqueues class: RUNTIME_CAP_BLOCK_TEST
#
# Purpose:
#   Test runtime sandbox/cap enforcement against a payload that opens a TCP
#   listener and spawns a child shell writing to $HOME.
#
# Expected result:
#   A job using this class should not complete successfully.
#
# The class uses defence in depth:
#   - strict systemd sandbox where supported
#   - runtime process/socket caps
#   - port allow-list excluding 61000
#

CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto

# Strongest systemd-backed sandbox level.
# This should remove network access and make HOME read-only where supported.
CLASS_DEFAULT_SANDBOX_LEVEL=strict

# Runtime caps monitored after launch.
CLASS_DEFAULT_RUNTIME_CAPS="no-spawn-shell,no-network-tools,only-local-sockets,only-port"
CLASS_DEFAULT_RUNTIME_CAP_INTERVAL=1

# Deliberately exclude 61000.
# The test payload opens 61000, so only-port should object.
CLASS_DEFAULT_RUNTIME_CAP_PORTS="5432,6379,8000-8099"

# Keep logs bounded for repeated tests.
CLASS_DEFAULT_MAX_LOG_SIZE_BYTES=1048576

# Optional static preflight: script must exist and be executable.
queue_class_shared_asset runnable script "${QUEUEBASH_COMMAND_ARG_1_ABSPATH}"

# Optional static audit.
# This is a useful early warning, but the runtime caps above are the main test.
queue_class_shared_asset secaudit script_safe "${QUEUEBASH_COMMAND_ARG_1_ABSPATH}" strict=0
