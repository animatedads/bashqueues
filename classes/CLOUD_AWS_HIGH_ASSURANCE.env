# bashqueues class: CLOUD_AWS_HIGH_ASSURANCE
CLASS_ALLOW_PARALLEL=0
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto
queue_class_shared_asset aws auth_active _
queue_class_shared_asset aws region_allowed "eu-west-2,us-gov-west-1"
queue_class_shared_asset cloud_resource available aws type=vm compliance=high-assurance min_cpu=4 min_mem_gb=16 class=CLOUD_AWS_HIGH_ASSURANCE
queue_class_shared_asset aws finops_budget_ok high-assurance policy_file=policies.d/aws/cost-policy.example.json expected_hourly_usd=0.20
