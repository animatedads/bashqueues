# bashqueues class: CLOUD_AZURE_GDPR
# Purpose: Example Azure GDPR/data-protection posture class. Documentation/contract template only.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto

queue_class_shared_asset azure region allowed-policy=uk-eu required=1
queue_class_shared_asset azure legal framework=GDPR retention_evidence=1 deletion_evidence=1
queue_class_shared_asset azure audit activity_log required=1
queue_class_shared_asset azure storage sas_redaction=1 signed_url_redaction=1
