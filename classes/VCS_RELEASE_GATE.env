# bashqueues class: VCS_RELEASE_GATE
#
# Purpose:
#   Serial release gate for source-controlled delivery where the repository may
#   be Git, Subversion, CVS, Mercurial, or Perforce.
#
# Site overrides:
#   QUEUEBASH_VCS_RELEASE_REPO=/srv/src/project
#   QUEUEBASH_VCS_RELEASE_TYPE=git|svn|cvs|hg|p4|auto
#   QUEUEBASH_VCS_RELEASE_BRANCH=main
#   QUEUEBASH_VCS_RELEASE_TAG=RELEASE_1_0       # CVS
#   QUEUEBASH_VCS_RELEASE_URL_FRAGMENT=/trunk  # SVN
#   QUEUEBASH_VCS_RELEASE_STREAM=//depot/main  # Perforce

CLASS_ALLOW_PARALLEL=0
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_SANDBOX_LEVEL=restrict-egress
CLASS_DEFAULT_SECCOMP_PROFILE=docker-default
CLASS_DEFAULT_RUNTIME_CAPS=no-spawn-shell
CLASS_DEFAULT_TIMEOUT=60m
CLASS_DEFAULT_KILL_AFTER=30s

queue_class_exclusive_claim "vcs:release:${QUEUEBASH_VCS_RELEASE_NAME:-default}"

queue_class_shared_asset vcs repo_exists \
  "${QUEUEBASH_VCS_RELEASE_REPO:-$PWD}" \
  type="${QUEUEBASH_VCS_RELEASE_TYPE:-auto}" \
  timeout="${QUEUEBASH_VCS_TIMEOUT:-10}"

queue_class_shared_asset vcs clean_tree \
  "${QUEUEBASH_VCS_RELEASE_REPO:-$PWD}" \
  type="${QUEUEBASH_VCS_RELEASE_TYPE:-auto}" \
  timeout="${QUEUEBASH_VCS_TIMEOUT:-20}"

case "${QUEUEBASH_VCS_RELEASE_TYPE:-git}" in
  svn|subversion)
    queue_class_shared_asset vcs branch "${QUEUEBASH_VCS_RELEASE_REPO:-$PWD}" \
      type=svn require_url_contains="${QUEUEBASH_VCS_RELEASE_URL_FRAGMENT:-/trunk}" timeout="${QUEUEBASH_VCS_TIMEOUT:-10}"
    ;;
  cvs)
    queue_class_shared_asset vcs branch "${QUEUEBASH_VCS_RELEASE_REPO:-$PWD}" \
      type=cvs require_tag="${QUEUEBASH_VCS_RELEASE_TAG:-HEAD}"
    ;;
  hg|mercurial)
    queue_class_shared_asset vcs branch "${QUEUEBASH_VCS_RELEASE_REPO:-$PWD}" \
      type=hg require_branch="${QUEUEBASH_VCS_RELEASE_BRANCH:-default}" timeout="${QUEUEBASH_VCS_TIMEOUT:-10}"
    ;;
  p4|perforce)
    queue_class_shared_asset vcs branch "${QUEUEBASH_VCS_RELEASE_REPO:-$PWD}" \
      type=p4 require_stream="${QUEUEBASH_VCS_RELEASE_STREAM:-//depot/main}" timeout="${QUEUEBASH_VCS_TIMEOUT:-10}"
    ;;
  *)
    queue_class_shared_asset vcs branch "${QUEUEBASH_VCS_RELEASE_REPO:-$PWD}" \
      type=git require_branch="${QUEUEBASH_VCS_RELEASE_BRANCH:-main}" timeout="${QUEUEBASH_VCS_TIMEOUT:-10}"
    ;;
esac
