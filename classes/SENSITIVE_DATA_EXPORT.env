# bashqueues class: SENSITIVE_DATA_EXPORT
#
# Purpose:
#   Exports, extracts, and transfers that touch sensitive or regulated data.
#   Maximum isolation: strict sandbox, seccomp strict, secaudit gates,
#   no network access, explicit authorisation required.
#
# Security model:
#   This class is intentionally the most restrictive in the library.
#   - strict sandbox: ProtectHome=read-only, PrivateNetwork, PrivateTmp
#   - seccomp strict: only @system-service syscalls allowed
#   - secaudit: no C2, no privesc, no obfuscation checked before dispatch
#   - runtime caps: no-spawn-shell, no-network-sockets
#   - off-hours only with no automatic exception path
#
# Authorisation:
#   Attaching a signed authorisation code is strongly recommended.
#   Configure CLASS_POLICY_EXCEPTION_FLAGS_REQUIRE=authorisation in the
#   active class-statement policy to enforce this site-wide.
#
# Site overrides:
#   QUEUEBASH_EXPORT_SCRIPT      - the export script to audit (for secaudit gate)
#   QUEUEBASH_EXPORT_OUTPUT_DIR  - export destination directory
#   QUEUEBASH_EXPORT_LOG_DIR     - export audit log directory

CLASS_ALLOW_PARALLEL=0
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=systemd
CLASS_DEFAULT_SANDBOX_LEVEL=strict
CLASS_DEFAULT_SECCOMP_PROFILE=strict
CLASS_DEFAULT_RUNTIME_CAPS=no-spawn-shell,no-network-sockets
CLASS_DEFAULT_RUNTIME_CAP_INTERVAL=1
CLASS_DEFAULT_TIMEOUT=2h
CLASS_DEFAULT_KILL_AFTER=30s
CLASS_DEFAULT_MAX_LOG_SIZE_BYTES=104857600

queue_class_exclusive_claim "sensitive:export:slot"

# Static security audit of the export script before dispatch.
queue_class_shared_asset secaudit no_network_c2 \
  "${QUEUEBASH_EXPORT_SCRIPT:-/opt/scripts/export.sh}"
queue_class_shared_asset secaudit no_privesc \
  "${QUEUEBASH_EXPORT_SCRIPT:-/opt/scripts/export.sh}"
queue_class_shared_asset secaudit no_obfuscation \
  "${QUEUEBASH_EXPORT_SCRIPT:-/opt/scripts/export.sh}"

# Output and log directories must exist and have space.
queue_class_shared_asset path freespace \
  "${QUEUEBASH_EXPORT_OUTPUT_DIR:-/var/lib/exports}" min_mb=1000
queue_class_shared_asset path freespace \
  "${QUEUEBASH_EXPORT_LOG_DIR:-/var/log/exports}" min_mb=100

# Strict time window: exports only during approved hours.
queue_class_shared_asset time window "export-approved-window" \
  weekdays=mon-fri \
  weekday_windows=22:00-04:00 \
  weekends=sat-sun \
  weekend_windows=00:00-06:00
