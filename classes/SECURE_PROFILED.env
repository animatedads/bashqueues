# bashqueues class: SECURE_PROFILED
# Purpose:
#   Template for tasks whose known-good behaviour has been interrogated,
#   reviewed, approved, and signed.  Replace PROFILE_NAME with a concrete
#   profile name in a derived class before use.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=5
CLASS_DEFAULT_RUNNER=systemd
CLASS_DEFAULT_SANDBOX_LEVEL=strict
CLASS_DEFAULT_RUNTIME_CAPS=no-spawn-shell,no-network-tools,only-local-sockets

# Example policy gates for a derived class:
# CLASS_DEFAULT_SECCOMP_PROFILE=PROFILE_NAME
# queue_class_shared_asset secprofile profile_verified PROFILE_NAME
# queue_class_shared_asset netprofile profile_verified PROFILE_NAME
# queue_class_shared_asset fileprofile profile_verified PROFILE_NAME
