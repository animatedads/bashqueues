# bashqueues class: SECURE_PROFILED
# Purpose:
#   Template for tasks whose known-good behaviour has been interrogated,
#   reviewed, approved, and signed.  This class performs dispatch-time
#   preflight checks against all three approved interrogation profiles:
#   secprofile, netprofile, and fileprofile.
#
# Recommended creation command:
#   queue profile interrogate class-template SECURE_GOODREXX --profile goodrexx --required-signer ops-release

CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=5
CLASS_DEFAULT_RUNNER=systemd
CLASS_DEFAULT_SANDBOX_LEVEL=strict
CLASS_DEFAULT_RUNTIME_CAPS=no-spawn-shell,no-network-tools,only-local-sockets

# Override these in a derived class/template copy.
PROFILE_NAME="${PROFILE_NAME:-}"
PROFILE_ALLOW_SELF_SIGNED="${PROFILE_ALLOW_SELF_SIGNED:-0}"
PROFILE_REQUIRED_SIGNER="${PROFILE_REQUIRED_SIGNER:-}"
PROFILE_ROOT="${PROFILE_ROOT:-}"

profile_gate_args=(allow_self_signed="$PROFILE_ALLOW_SELF_SIGNED")
[[ -n "$PROFILE_REQUIRED_SIGNER" ]] && profile_gate_args+=(required_signer="$PROFILE_REQUIRED_SIGNER")
[[ -n "$PROFILE_ROOT" ]] && profile_gate_args+=(profile_root="$PROFILE_ROOT")

if [[ -n "$PROFILE_NAME" ]]; then
    queue_class_shared_asset secprofile profile_verified "$PROFILE_NAME" "${profile_gate_args[@]}"
    queue_class_shared_asset netprofile profile_verified "$PROFILE_NAME" "${profile_gate_args[@]}"
    queue_class_shared_asset fileprofile profile_verified "$PROFILE_NAME" "${profile_gate_args[@]}"
else
    # Fail closed if somebody uses the template without binding a profile.
    queue_class_shared_asset secprofile profile_verified __PROFILE_NAME_REQUIRED__ allow_self_signed=0 required_signer=__PROFILE_REQUIRED__
fi
