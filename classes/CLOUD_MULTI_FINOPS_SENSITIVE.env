# bashqueues class: CLOUD_MULTI_FINOPS_SENSITIVE
# Purpose:
#   Cost-sensitive cloud workloads that must not run during severe FinOps anomalies.

CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=50
CLASS_DEFAULT_RUNNER=auto
CLASS_DEFAULT_SANDBOX_LEVEL=restrict-egress
CLASS_DEFAULT_RUNTIME_CAPS=no-spawn-shell,no-network-tools
CLASS_EXEC_ENV=staging
CLASS_EFFECT=readonly

# Reads $QUEUEBASH_ROOT/streams/finops.health by default.
queue_class_shared_asset finops anomaly_free _ block_on=error missing=ok
