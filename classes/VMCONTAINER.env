# bashqueues class: VMCONTAINER
# Template class for container/VM/orchestrator-aware jobs.
# Copy and edit targets for the local site before use.

CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=0
CLASS_DEFAULT_RUNNER=auto

# Metadata examples only. Uncomment after replacing targets.
