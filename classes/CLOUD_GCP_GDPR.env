# bashqueues class: CLOUD_GCP_GDPR
# Purpose: Example GCP GDPR/data-protection posture class. Documentation/contract template only.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto

queue_class_shared_asset gcp region allowed-policy=uk-eu required=1
queue_class_shared_asset gcp legal framework=GDPR retention_evidence=1 deletion_evidence=1
queue_class_shared_asset gcp audit logging required=1
queue_class_shared_asset gcp storage signed_url_redaction=1
