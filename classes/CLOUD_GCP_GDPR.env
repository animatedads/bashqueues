# bashqueues class: CLOUD_GCP_GDPR
# Purpose: GCP GDPR workload with identity, sovereignty, and FinOps gates.

CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=20
CLASS_DEFAULT_RUNNER=systemd
CLASS_DEFAULT_SANDBOX_LEVEL=strict

queue_class_shared_asset gcp auth_active _
queue_class_shared_asset sovereign framework_allowed "GDPR"
queue_class_shared_asset finops spot_price_below "0.05" instance_type="e2-standard-4"
