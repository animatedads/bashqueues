# bashqueues class: REPORT_GENERATION
#
# Purpose:
#   Scheduled report generation: PDF rendering, spreadsheet production,
#   dashboard snapshots, and similar read-heavy, write-limited workloads.
#   Multiple reports may run in parallel (they are read-only on source data)
#   but capped to avoid saturating the database or file server.
#
# Concurrency model:
#   Up to CLASS_MAX_CONCURRENT simultaneous report jobs. Shared (not exclusive)
#   claim on the report slot so jobs queue but do not block unrelated work.
#
# Site overrides:
#   QUEUEBASH_REPORT_OUTPUT_DIR  - report drop directory (default /var/lib/reports)
#   QUEUEBASH_REPORT_DB_HOST     - reporting database host:port/db
#   QUEUEBASH_REPORT_DB_USER     - reporting database user (default readonly)

CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=3
CLASS_DEFAULT_RUNNER=auto
CLASS_DEFAULT_SANDBOX_LEVEL=network-none
CLASS_DEFAULT_SECCOMP_PROFILE=docker-default
CLASS_DEFAULT_TIMEOUT=90m
CLASS_DEFAULT_KILL_AFTER=30s
CLASS_DEFAULT_CPU_LIMIT=60%
CLASS_DEFAULT_MEM_LIMIT=1G
CLASS_DEFAULT_MAX_LOG_SIZE_BYTES=10485760

# Shared slot: multiple reports can run but they are counted.
queue_class_shared_asset sys memory_available "system" min_mb=256
queue_class_shared_asset sys cpu_load "system" max_load_1m=8.0

# Output directory must be writable and have space.
queue_class_shared_asset path freespace \
  "${QUEUEBASH_REPORT_OUTPUT_DIR:-/var/lib/reports}" min_mb=200

# Reporting database must be reachable.
queue_class_shared_asset db postgres_connect \
  "${QUEUEBASH_REPORT_DB_HOST:-localhost:5432/reporting}" \
  user="${QUEUEBASH_REPORT_DB_USER:-readonly}" \
  timeout=5

# Scheduling: allow all hours but prefer quiet periods.
queue_class_shared_asset time window "report-window" \
  weekdays=mon-fri \
  weekday_windows=00:00-24:00 \
  weekends=sat-sun \
  weekend_windows=always
