# bashqueues class: CLOUD_IBM_FINREG
# Purpose: IBM Cloud regulated financial-services posture template.

CLASS_ALLOW_PARALLEL=0
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=systemd
CLASS_DEFAULT_SANDBOX_LEVEL=strict
CLASS_DEFAULT_SECCOMP_PROFILE=docker-default
CLASS_DEFAULT_RUNTIME_CAPS="no-spawn-shell,no-network-tools,only-local-sockets"

QUEUEBASH_CLOUD_PROVIDER=ibm
QUEUEBASH_IBM_AUTH_REQUIRED=1
QUEUEBASH_GOVERNANCE_POSTURE="IBM_CLOUD_FINANCIAL_SERVICES"

queue_class_shared_asset ibm_identity auth_active _
queue_class_shared_asset ibm_identity target_region_allowed FINREG
queue_class_shared_asset legal retention_respected dataset:financial-records effect=destructive registry_file=/etc/queuebash/legal_registry.tsv
queue_class_shared_asset legal jurisdiction_allowed dataset:financial-records worker_jurisdiction=FINREG registry_file=/etc/queuebash/legal_registry.tsv
queue_class_shared_asset integrity manifest_verified /etc/queuebash/manifests/ibm_finreg.manifest
# IBM FinOps cache gates are contract-only in 0.18.12; collectors are external/future.
queue_class_shared_asset ibm_finops cost_cache_fresh account cache_file=/etc/queuebash/finops/ibm_cost_cache.json max_age_seconds=86400
queue_class_shared_asset ibm_finops budget_remaining ibm-finreg min_remaining=1 cache_file=/etc/queuebash/finops/ibm_cost_cache.json
queue_class_shared_asset ibm_finops anomaly_free account health_file=/etc/queuebash/finops/ibm_finops.health block_on=error missing=block
