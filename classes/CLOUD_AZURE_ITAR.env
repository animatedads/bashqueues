# bashqueues class: CLOUD_AZURE_ITAR
# Purpose: Azure export-control/ITAR-style posture template pending validation.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto

queue_class_shared_asset azure legal framework=ITAR export_control=1 status=mapped_pending_validation
queue_class_shared_asset azure region allowed-policy=itar-us-only required=1
queue_class_shared_asset azure identity managed-identity required=1
queue_class_shared_asset azure audit activity_log required=1
