# bashqueues class: ENERGY_AWARE_BATCH
# Purpose: non-essential batch work that should run only when electricity price/carbon policy passes.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=0
CLASS_DEFAULT_RUNNER=auto

queue_class_shared_asset grid_energy price_below 0.15 cache_file=/var/cache/bashqueues/grid-energy/site.json max_age_seconds=900
queue_class_shared_asset grid_energy carbon_below 150 cache_file=/var/cache/bashqueues/grid-energy/site.json max_age_seconds=900
