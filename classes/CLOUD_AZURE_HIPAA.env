CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=8
CLASS_DEFAULT_RUNNER=systemd
CLASS_DEFAULT_SANDBOX_LEVEL=strict
queue_class_shared_asset azure auth_active _
queue_class_shared_asset sovereign framework_allowed "HIPAA"
queue_class_shared_asset audit stream_verified "HIPAA" require_remote=1
queue_class_shared_asset crypto volume_encrypted "${QUEUEBASH_DATA_DIR:-/data/work}"
queue_class_shared_asset net egress_policy "private-only"
