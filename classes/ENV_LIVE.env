# bashqueues class: ENV_LIVE
# Purpose: run jobs in the live execution environment profile.
# Phase 1 records and validates the environment; runner-level chroot enforcement follows later.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=0
CLASS_DEFAULT_RUNNER=auto
CLASS_DEFAULT_SANDBOX_LEVEL=strict
CLASS_DEFAULT_RUNTIME_CAPS=no-spawn-shell,no-network-tools,only-local-sockets
CLASS_EXEC_ENV=live
queue_class_shared_asset env profile_required live
queue_class_shared_asset env secret_scope live profile=live
queue_class_shared_asset env endpoint_scope live profile=live
