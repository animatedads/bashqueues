# bashqueues class: CLOUD_EDGE_EXPORT_REVIEW
# Purpose: Edge workload template requiring export/control review.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto
queue_class_shared_asset edge_cloud legal export_review=1 required=1
queue_class_shared_asset edge_cloud region allowed-policy=review-required
