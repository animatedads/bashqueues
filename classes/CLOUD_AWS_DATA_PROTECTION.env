# bashqueues class: CLOUD_AWS_DATA_PROTECTION
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto
queue_class_shared_asset aws region_allowed "eu-west-2,eu-west-1"
queue_class_shared_asset cloud_resource available aws type=vm compliance=customer-data min_cpu=2 min_mem_gb=8 class=CLOUD_AWS_DATA_PROTECTION
queue_class_shared_asset aws finops_budget_ok customer-data policy_file=policies.d/aws/cost-policy.example.json expected_hourly_usd=0.10
