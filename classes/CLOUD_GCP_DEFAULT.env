# bashqueues class: CLOUD_GCP_DEFAULT
# Purpose: Example GCP governed workload class. Documentation/contract template only.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=2
CLASS_DEFAULT_RUNNER=auto

queue_class_shared_asset gcp identity service-account required=1 no-key-files=1
queue_class_shared_asset gcp region allowed-policy=default required=1
queue_class_shared_asset gcp audit logging required=1
