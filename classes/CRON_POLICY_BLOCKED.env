# bashqueues class: CRON_POLICY_BLOCKED
# Purpose: fail-closed cron selector target when governance metadata cannot be routed.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto
CLASS_DEFAULT_SANDBOX_LEVEL=strict
CLASS_DEFAULT_RUNTIME_CAPS="no-spawn-shell,no-network-tools,only-local-sockets"
queue_class_shared_asset path exists "/__queuebash_cron_policy_selector_no_compliant_route__"
