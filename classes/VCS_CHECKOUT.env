# bashqueues class: VCS_CHECKOUT
#
# Purpose:
#   Read/update a local source checkout from Git, Subversion, CVS, Mercurial, or
#   Perforce without assuming that Git is the only tenant.
#
# Site overrides:
#   QUEUEBASH_VCS_REPO=/srv/src/project
#   QUEUEBASH_VCS_TYPE=auto|git|svn|cvs|hg|p4

CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=2
CLASS_DEFAULT_SANDBOX_LEVEL=restrict-egress
CLASS_DEFAULT_SECCOMP_PROFILE=docker-default
CLASS_DEFAULT_RUNTIME_CAPS=no-spawn-shell
CLASS_DEFAULT_TIMEOUT=30m
CLASS_DEFAULT_KILL_AFTER=30s

queue_class_shared_asset vcs repo_exists \
  "${QUEUEBASH_VCS_REPO:-$PWD}" \
  type="${QUEUEBASH_VCS_TYPE:-auto}" \
  timeout="${QUEUEBASH_VCS_TIMEOUT:-10}"

case "${QUEUEBASH_VCS_TYPE:-auto}" in
  auto)
    # Auto-detection keeps the class drop-in friendly. Pin QUEUEBASH_VCS_TYPE
    # when a worker must prove that a specific legacy client is installed.
    ;;
  *)
    queue_class_shared_asset vcs tool_available \
      "${QUEUEBASH_VCS_TYPE}" \
      type="${QUEUEBASH_VCS_TYPE}"
    ;;
esac
