# bashqueues class: GITHUB_PUBLISH
#
# Purpose:
#   Gate GitHub publication jobs until the local repository and network are ready.
#
# Example:
#   queue submit publish_to_git --class GITHUB_PUBLISH -- bash publish_to_github.sh
#
# Site overrides:
#   export QUEUEBASH_GITHUB_REPO=/home/hc3/bashqueues
#   export QUEUEBASH_GITHUB_BRANCH=main

CLASS_ALLOW_PARALLEL=0
CLASS_MAX_CONCURRENT=1

# New class asset record format. Arguments are real Bash arguments, not a
# colon/comma-delimited string. Targets and parameter values may contain any
# number of ':' or ',' characters.
queue_class_exclusive_claim "github_publish:slot"

queue_class_shared_asset net http_status "https://github.com" \
  timeout=5 \
  accept_status="200,201,204,301,302,304,307,308,403"

queue_class_shared_asset git repo_exists \
  "${QUEUEBASH_GITHUB_REPO:-/home/hc3/bashqueues}"

queue_class_shared_asset git branch \
  "${QUEUEBASH_GITHUB_REPO:-/home/hc3/bashqueues}" \
  require_branch="${QUEUEBASH_GITHUB_BRANCH:-main}"
