# bashqueues class: CLOUD_OCI_LEGAL_COMPLIANCE
# Purpose: Example OCI legal/compliance class. Contract-only in this package.
CLASS_ALLOW_PARALLEL=0
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto

queue_class_shared_asset oci identity instance-principal required=1
queue_class_shared_asset oci region allowed policy=policies.d/oci/regions.tsv
queue_class_shared_asset legal sovereignty provider=oci cross_border_review=1
queue_class_shared_asset legal retention policy=policies.d/oci/legal-frameworks.example.tsv
queue_class_shared_asset secaudit logging required=1 immutable_evidence=1
