# bashqueues class: CLOUD_OCI_ARTIFACT_RUNNER
# Purpose: Example OCI artifact/log handoff runner. Contract-only in this package.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=2
CLASS_DEFAULT_RUNNER=auto

queue_class_shared_asset oci identity instance-principal required=1
queue_class_shared_asset oci object-storage artifacts required=1 par_expiry_required=1 par_redaction=1
queue_class_shared_asset legal retention days=30 deletion_evidence=1
queue_class_shared_asset secaudit logging required=1
