# bashqueues class: FILE_TRANSFER
#
# Purpose:
#   Managed file transfers: SFTP, rsync, SCP, object storage uploads/downloads.
#   Network access is permitted (unlike most classes) but metered via the
#   net:allowance asset when a metered interface is configured.
#   Serialised to prevent bandwidth saturation.
#
# Security model:
#   network-none is NOT applied here — transfers require network.
#   Runtime cap only-local-sockets is NOT applied.
#   restrict-egress sandbox constrains outbound to declared destinations.
#   no-spawn-shell runtime cap still applies.
#
# Site overrides:
#   QUEUEBASH_TRANSFER_STAGING_DIR   - local staging area (default /var/lib/transfer/staging)
#   QUEUEBASH_TRANSFER_IFACE         - network interface to meter (default eth0)
#   QUEUEBASH_TRANSFER_ALLOWANCE     - monthly allowance in bytes (default 0 = unmetered)
#   QUEUEBASH_TRANSFER_DESTINATION   - FQDN or IP of transfer target (used in restrict-egress)

CLASS_ALLOW_PARALLEL=0
CLASS_MAX_CONCURRENT=2
CLASS_DEFAULT_RUNNER=auto
CLASS_DEFAULT_SANDBOX_LEVEL=restrict-egress
CLASS_DEFAULT_RUNTIME_CAPS=no-spawn-shell
CLASS_DEFAULT_RUNTIME_CAP_INTERVAL=1
CLASS_DEFAULT_TIMEOUT=6h
CLASS_DEFAULT_KILL_AFTER=60s
CLASS_DEFAULT_MAX_LOG_SIZE_BYTES=10485760

# Serialise to prevent bandwidth saturation.
queue_class_shared_asset sys iowait "system" max_percent=40

# Staging directory must exist and have space.
queue_class_shared_asset path freespace \
  "${QUEUEBASH_TRANSFER_STAGING_DIR:-/var/lib/transfer/staging}" min_mb=500
queue_class_shared_asset path mount \
  "${QUEUEBASH_TRANSFER_STAGING_DIR:-/var/lib/transfer/staging}"

# Network interface must be up.
queue_class_shared_asset net interface_state \
  "${QUEUEBASH_TRANSFER_IFACE:-eth0}"

# Metered link: do not transfer if allowance exhausted.
# When QUEUEBASH_TRANSFER_ALLOWANCE=0 this check is a no-op (see net.sh).
queue_class_shared_asset net allowance \
  "${QUEUEBASH_TRANSFER_IFACE:-eth0}" \
  allowance_bytes="${QUEUEBASH_TRANSFER_ALLOWANCE:-0}" \
  direction=rx_tx

# Scheduling: transfers run overnight to avoid business-hours bandwidth impact.
queue_class_shared_asset time window "transfer-overnight" \
  weekdays=mon-fri \
  weekday_windows=20:00-06:00 \
  weekends=sat-sun \
  weekend_windows=always
