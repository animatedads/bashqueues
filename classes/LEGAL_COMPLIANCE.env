# bashqueues class: LEGAL_COMPLIANCE
# Purpose:
#   Destructive/export/archive work over legally governed datasets.
#   Site policies should bind specific dataset/case registry records.

CLASS_ALLOW_PARALLEL=0
CLASS_MAX_CONCURRENT=5
CLASS_DEFAULT_RUNNER=auto
CLASS_DEFAULT_SANDBOX_LEVEL=strict
CLASS_DEFAULT_RUNTIME_CAPS=no-spawn-shell,no-network-tools,only-local-sockets
CLASS_EXEC_ENV=live
CLASS_EFFECT=destructive
QUEUEBASH_CLASS_IS_DESTRUCTIVE=1

# Bind these in site-specific subclasses or mandatory policy statements:
#   queue_class_shared_asset legal retention_respected dataset:case-123 effect=destructive registry_file=/etc/bashqueues/legal_registry.tsv
#   queue_class_shared_asset legal jurisdiction_allowed dataset:case-123 worker_jurisdiction=UK_DPA registry_file=/etc/bashqueues/legal_registry.tsv
