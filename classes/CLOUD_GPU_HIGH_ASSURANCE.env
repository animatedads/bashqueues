# bashqueues class: CLOUD_GPU_HIGH_ASSURANCE
# Purpose: Example high-assurance GPU cloud class. Contract/template only.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto

queue_class_shared_asset gpu_cloud provider approved required=1
queue_class_shared_asset gpu_cloud accelerator dedicated_or_isolated=1 required=1
queue_class_shared_asset gpu_cloud network private_connectivity=1 public_ingress=denied
queue_class_shared_asset gpu_cloud storage signed_url_redaction=1 artifact_pointer_only=1
queue_class_shared_asset gpu_cloud legal export_review=1 retention_evidence=1 deletion_evidence=1
queue_class_shared_asset secaudit logging required=1
