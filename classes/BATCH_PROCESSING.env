# bashqueues class: BATCH_PROCESSING
#
# Purpose:
#   General-purpose batch processing for data transformation, report generation,
#   and file-based workloads. Serialised per logical batch group via exclusive
#   claim. Safe defaults: network isolated, reasonable resource caps.
#
# Concurrency model:
#   One job at a time per batch group. Set CLASS_MAX_CONCURRENT=0 and remove
#   the exclusive claim if parallel batch runs are acceptable for your workload.
#
# Site overrides (export before sourcing):
#   QUEUEBASH_BATCH_INPUT_DIR   - required input directory (default /var/lib/batch/input)
#   QUEUEBASH_BATCH_OUTPUT_DIR  - required output directory (default /var/lib/batch/output)
#   QUEUEBASH_BATCH_SCRATCH_DIR - working scratch space (default /var/tmp/batch)
#
# Override model:
#   Use queue exception add <qid> time:window --reason "..." for daytime runs.

CLASS_ALLOW_PARALLEL=0
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto
CLASS_DEFAULT_SANDBOX_LEVEL=network-none
CLASS_DEFAULT_SECCOMP_PROFILE=docker-default
CLASS_DEFAULT_TIMEOUT=4h
CLASS_DEFAULT_KILL_AFTER=60s
CLASS_DEFAULT_CPU_LIMIT=80%
CLASS_DEFAULT_MEM_LIMIT=2G
CLASS_DEFAULT_MAX_LOG_SIZE_BYTES=52428800
CLASS_DEFAULT_LOG_OVERFLOW_POLICY=stderr-only

# Serialise batch jobs so they do not compete for I/O.
queue_class_exclusive_claim "batch:processing:slot"

# Scheduling: batch jobs run overnight by default.
queue_class_shared_asset time window "batch-overnight" \
  weekdays=mon-fri \
  weekday_windows=19:00-06:00 \
  weekends=sat-sun \
  weekend_windows=always

# System headroom: do not start if the machine is already loaded.
queue_class_shared_asset sys cpu_load "system" max_load_1m=6.0
queue_class_shared_asset sys memory_available "system" min_mb=512

# I/O health: do not start if the disk is nearly full.
queue_class_shared_asset path freespace \
  "${QUEUEBASH_BATCH_INPUT_DIR:-/var/lib/batch/input}" min_mb=100
queue_class_shared_asset path freespace \
  "${QUEUEBASH_BATCH_OUTPUT_DIR:-/var/lib/batch/output}" min_mb=500
queue_class_shared_asset path freespace \
  "${QUEUEBASH_BATCH_SCRATCH_DIR:-/var/tmp/batch}" min_mb=200
