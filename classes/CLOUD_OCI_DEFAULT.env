# bashqueues class: CLOUD_OCI_DEFAULT
# Purpose: Example OCI-governed workload class. Contract-only in this package.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=2
CLASS_DEFAULT_RUNNER=auto

# Future OCI asset criteria, documented but not wired by this package.
queue_class_shared_asset oci identity instance-principal required=1
queue_class_shared_asset oci metadata imds-v2 required=1
queue_class_shared_asset oci region allowed policy=policies.d/oci/regions.tsv
queue_class_shared_asset secaudit logging required=1
