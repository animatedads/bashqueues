# bashqueues class: CLOUD_EU_SOVEREIGN_ARTIFACT_RUNNER
# Purpose: Artifact/log handoff template for EU sovereign providers.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto

queue_class_shared_asset eu_sovereign storage artifacts required=1 signed_url_redaction=1
queue_class_shared_asset eu_sovereign legal retention_evidence=1 deletion_evidence=1
queue_class_shared_asset secaudit logging required=1
