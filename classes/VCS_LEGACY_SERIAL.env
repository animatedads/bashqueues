# bashqueues class: VCS_LEGACY_SERIAL
#
# Purpose:
#   Conservative class for fragile legacy change-control systems. Use for CVS,
#   older Subversion repositories, and Perforce depots where workspace locks or
#   server age make concurrency a risk.

CLASS_ALLOW_PARALLEL=0
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_SANDBOX_LEVEL=restrict-egress
CLASS_DEFAULT_SECCOMP_PROFILE=docker-default
CLASS_DEFAULT_RUNTIME_CAPS=no-spawn-shell
CLASS_DEFAULT_TIMEOUT=2h
CLASS_DEFAULT_KILL_AFTER=60s
CLASS_DEFAULT_MAX_LOG_SIZE_BYTES=52428800

queue_class_exclusive_claim "vcs:legacy:${QUEUEBASH_VCS_LEGACY_NAME:-default}"

queue_class_shared_asset vcs repo_exists \
  "${QUEUEBASH_VCS_LEGACY_REPO:-$PWD}" \
  type="${QUEUEBASH_VCS_LEGACY_TYPE:-auto}" \
  timeout="${QUEUEBASH_VCS_TIMEOUT:-20}"

queue_class_shared_asset vcs clean_tree \
  "${QUEUEBASH_VCS_LEGACY_REPO:-$PWD}" \
  type="${QUEUEBASH_VCS_LEGACY_TYPE:-auto}" \
  timeout="${QUEUEBASH_VCS_TIMEOUT:-30}"
