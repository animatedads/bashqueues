# bashqueues class: CLOUD_IBM_GDPR
# Purpose: IBM Cloud GDPR workload with identity, sovereignty, and strict defaults.

CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=10
CLASS_DEFAULT_RUNNER=systemd
CLASS_DEFAULT_SANDBOX_LEVEL=strict
CLASS_DEFAULT_SECCOMP_PROFILE=docker-default
CLASS_DEFAULT_RUNTIME_CAPS="no-spawn-shell,no-network-tools"

QUEUEBASH_CLOUD_PROVIDER=ibm
QUEUEBASH_IBM_AUTH_REQUIRED=1

queue_class_shared_asset ibm_identity auth_active _
queue_class_shared_asset ibm_identity target_region_allowed GDPR
queue_class_shared_asset sovereign framework_allowed "GDPR"
