# bashqueues class: CLOUD_AZURE_ARTIFACT_RUNNER
# Purpose: Azure artifact/log handoff class template.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=4
CLASS_DEFAULT_RUNNER=auto

queue_class_shared_asset azure storage artifact-container required=1 sas_redaction=1 signed_url_redaction=1
queue_class_shared_asset secaudit logging required=1
