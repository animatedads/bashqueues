# bashqueues class: INTERROGATE_PROFILE
# Purpose:
#   Behaviour interrogation / learning mode.  Use this to observe a task under
#   strace/ss/lsof and generate candidate profiles.  This class observes; it
#   does not enforce the generated policies.
CLASS_ALLOW_PARALLEL=0
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=direct
CLASS_DEFAULT_SANDBOX_LEVEL=off
CLASS_DEFAULT_SECCOMP_PROFILE=off
CLASS_DEFAULT_RUNTIME_CAPS=

QUEUEBASH_INTERROGATION_MODE=1
