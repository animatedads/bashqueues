# bashqueues class: CLOUD_OCI_HIGH_ASSURANCE
# Purpose: Example high-assurance OCI class with legal/compliance rails.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto

queue_class_shared_asset oci identity instance-principal required=1
queue_class_shared_asset oci metadata imds-v2 required=1
queue_class_shared_asset oci network nsg-required=1 egress=restricted
queue_class_shared_asset oci object-storage artifacts required=1 par_expiry_required=1 par_redaction=1
queue_class_shared_asset legal sovereignty provider=oci policy=policies.d/oci/regions.tsv
queue_class_shared_asset legal retention policy=policies.d/oci/legal-frameworks.example.tsv
queue_class_shared_asset integrity manifest verified=1
queue_class_shared_asset secaudit logging required=1
