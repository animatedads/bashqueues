# bashqueues class: DEADLINE_CRITICAL
#
# Purpose:
#   Jobs with hard deadlines that cannot be missed: month-end closes,
#   regulatory submissions, time-locked reconciliations. Combines deadline
#   monitoring with priority escalation, panic fallback, and optional
#   extra-worker start when the queue is saturated.
#
# Design:
#   - deadline:monitor tracks slack against drop_dead and escalates priority.
#   - deadline:panic fires past the point of no return, applying declared
#     fallback exceptions so time window and maintenance blocks are bypassed.
#   - Extra worker starts automatically when running jobs >= worker count
#     and CLASS_DEADLINE_ALLOW_EXTRA_WORKER=1.
#   - Adjust drop_dead, warn_slack, and pattern per workload.
#
# Override model:
#   Do not remove deadline assets from this class.
#   Use queue exception add <qid> time:window --reason "..." only for
#   pre-approved out-of-window runs with documented business justification.
#
# Site overrides:
#   QUEUEBASH_DEADLINE_DROP_DEAD    - wall-clock deadline HH:MM (default 05:00)
#   QUEUEBASH_DEADLINE_PATTERN      - standard or month-end (default month-end)
#   QUEUEBASH_DEADLINE_WARN_SLACK   - seconds before deadline to start warning (default 3600)
#   QUEUEBASH_DEADLINE_FALLBACK_DUR - estimated job duration for panic fallback (default 180m)

CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=0
CLASS_DEFAULT_RUNNER=auto
CLASS_DEFAULT_SANDBOX_LEVEL=network-none
CLASS_DEFAULT_SECCOMP_PROFILE=docker-default
CLASS_DEFAULT_TIMEOUT=6h
CLASS_DEFAULT_KILL_AFTER=60s
CLASS_DEFAULT_MAX_LOG_SIZE_BYTES=52428800

# Declare fallback assets: deadline:panic can bypass these when past point-of-no-return.
CLASS_DEADLINE_ALLOW_EXTRA_WORKER=1
CLASS_DEADLINE_MAX_EXTRA_WORKERS=1
CLASS_DEADLINE_FALLBACK_ASSETS="time:window snmp:truth_ok"

# Priority escalation as deadline approaches.
queue_class_shared_asset deadline monitor "deadline-critical" \
  drop_dead="${QUEUEBASH_DEADLINE_DROP_DEAD:-05:00}" \
  pattern="${QUEUEBASH_DEADLINE_PATTERN:-month-end}" \
  margin_pct=20 \
  warn_slack="${QUEUEBASH_DEADLINE_WARN_SLACK:-3600}" \
  warn_priority=70 \
  critical_priority=99 \
  start_worker=1 \
  start_worker_slack=0

# Panic mode: bypass time window and maintenance window when past point-of-no-return.
queue_class_shared_asset deadline panic "deadline-critical" \
  drop_dead="${QUEUEBASH_DEADLINE_DROP_DEAD:-05:00}" \
  pattern="${QUEUEBASH_DEADLINE_PATTERN:-month-end}" \
  margin_pct=20 \
  fallback_duration="${QUEUEBASH_DEADLINE_FALLBACK_DUR:-180m}" \
  critical_priority=99 \
  start_worker=1

# Normal scheduling: only active during approved window; panic overrides this.
queue_class_shared_asset time window "deadline-overnight" \
  weekdays=mon-fri \
  weekday_windows=18:00-06:00 \
  weekends=sat-sun \
  weekend_windows=always

queue_class_shared_asset sys memory_available "system" min_mb=512
queue_class_shared_asset sys cpu_load "system" max_load_1m=8.0
