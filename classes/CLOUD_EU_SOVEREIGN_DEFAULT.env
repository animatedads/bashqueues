# bashqueues class: CLOUD_EU_SOVEREIGN_DEFAULT
# Purpose: Example EU sovereign provider workload class. Contract/template only.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto

queue_class_shared_asset eu_sovereign provider allowlist=ovhcloud,scaleway,hetzner,otc required=1
queue_class_shared_asset eu_sovereign region jurisdiction=EU required=1
queue_class_shared_asset eu_sovereign legal framework=GDPR status=mapped_pending_validation
queue_class_shared_asset secaudit logging required=1
