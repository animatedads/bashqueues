# bashqueues class: CLOUD_GPU_ARTIFACT_RUNNER
# Purpose: Example GPU artifact/log handoff class. Contract/template only.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=4
CLASS_DEFAULT_RUNNER=auto

queue_class_shared_asset gpu_cloud provider approved required=1
queue_class_shared_asset gpu_cloud storage artifacts required=1 signed_url_redaction=1
queue_class_shared_asset gpu_cloud finops quota_check=1 cost_guard=1
queue_class_shared_asset gpu_cloud audit evidence_pointer=1
