# bashqueues class: CLOUD_AZURE_UK_DPA
# Purpose: Example Azure UK DPA posture class. Documentation/contract template only.
CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto

queue_class_shared_asset azure region allowed-policy=uk-only required=1
queue_class_shared_asset azure legal framework=UK_DPA retention_evidence=1 deletion_evidence=1
queue_class_shared_asset azure audit activity_log required=1
queue_class_shared_asset azure storage sas_redaction=1
