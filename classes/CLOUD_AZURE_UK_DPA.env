# bashqueues class: CLOUD_AZURE_UK_DPA
# Purpose: Azure UK data-protection workload with identity, sovereignty, and FinOps gates.

CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=10
CLASS_DEFAULT_RUNNER=systemd
CLASS_DEFAULT_SANDBOX_LEVEL=restrict-egress

queue_class_shared_asset azure auth_active _
queue_class_shared_asset sovereign framework_allowed "UK_DPA"
queue_class_shared_asset finops spot_price_below "0.06" instance_type="Standard_D4s_v3"
