# bashqueues class: IMMUTABLE_PAYLOAD
#
# Purpose:
#   Run critical operational payloads only when their approved script/config
#   manifest still matches.  This class is intentionally strict and is meant as
#   a template: point the manifest at an operator-owned manifest for the payload.

CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=5
CLASS_DEFAULT_RUNNER=auto
CLASS_DEFAULT_SANDBOX_LEVEL=strict
CLASS_DEFAULT_RUNTIME_CAPS=no-spawn-shell,no-network-tools,only-local-sockets

# Replace this manifest with the approved operator-owned manifest for the job.
# The integrity asset refuses user-writable manifests by default.
queue_class_shared_asset integrity manifest_verified /etc/bashqueues/manifests/immutable_payload.manifest
