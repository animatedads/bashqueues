# bashqueues class: OVERNIGHT_WINDOW
#
# Purpose:
#   Restrict normal overnight jobs to:
#     - Monday-Friday: 18:00 through 05:00
#     - Saturday/Sunday: any time
#
# Override model:
#   Do not remove this restriction from this class.
#   Use exception classes when an operator deliberately overrides it.

CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=0
CLASS_DEFAULT_RUNNER=auto

queue_class_shared_asset time window "overnight-window" \
  weekdays=mon-fri \
  weekday_windows=18:00-05:00 \
  weekends=sat-sun \
  weekend_windows=always
