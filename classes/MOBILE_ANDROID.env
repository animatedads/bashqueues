# bashqueues class: MOBILE_ANDROID
# Purpose: On-device job execution on Android (Termux/Proot). Throttled resource caps.
CLASS_ALLOW_PARALLEL=0
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto
CLASS_DEFAULT_SANDBOX_LEVEL=network-none
CLASS_DEFAULT_CPU_LIMIT=10
CLASS_DEFAULT_MEMORY_LIMIT=128M
CLASS_EGRESS_ALLOWED_JURISDICTION=GLOBAL
CLASS_EGRESS_REQUIRE_ENCRYPTION=1
CLASS_RESULT_RETENTION_DAYS=7
CLASS_IS_DESTRUCTIVE=0
queue_class_shared_asset net interface_state trusted-only
