# bashqueues class: INTERACTIVE_PRIORITY
#
# Purpose:
#   Short, user-triggered jobs that need fast response: ad-hoc queries,
#   on-demand report previews, interactive tool invocations. No time window
#   restriction, no serialisation, low resource limits. Designed to complete
#   in seconds or minutes.
#
# Design:
#   This class deliberately inverts the defaults: no overnight restriction,
#   no exclusive claim, low timeout. Jobs that exceed the timeout are
#   misbehaving and should fail fast. Priority is set by the submitter;
#   default priority is higher than background batch (5 vs 10).
#
# Site overrides:
#   QUEUEBASH_INTERACTIVE_MAX_LOG  - max log bytes (default 5MB)

CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=10
CLASS_DEFAULT_RUNNER=auto
CLASS_DEFAULT_SANDBOX_LEVEL=network-none
CLASS_DEFAULT_SECCOMP_PROFILE=docker-default
CLASS_DEFAULT_TIMEOUT=15m
CLASS_DEFAULT_KILL_AFTER=10s
CLASS_DEFAULT_CPU_LIMIT=50%
CLASS_DEFAULT_MEM_LIMIT=512M
CLASS_DEFAULT_MAX_LOG_SIZE_BYTES="${QUEUEBASH_INTERACTIVE_MAX_LOG:-5242880}"

queue_class_shared_asset sys cpu_load "system" max_load_1m=12.0
queue_class_shared_asset sys memory_available "system" min_mb=128
