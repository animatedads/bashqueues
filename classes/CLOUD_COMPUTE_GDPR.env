# bashqueues class: CLOUD_COMPUTE_GDPR
# Purpose: generic GDPR cloud compute. Worker must be in an approved region and price must be acceptable.

CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=10
CLASS_DEFAULT_RUNNER=systemd
CLASS_DEFAULT_SANDBOX_LEVEL=strict

queue_class_shared_asset sovereign framework_allowed "GDPR"
queue_class_shared_asset finops spot_price_below "0.08" instance_type="${QUEUEBASH_CLOUD_INSTANCE_TYPE:-m5.large}"
