# bashqueues class: BACKUP_JOB
#
# Purpose:
#   Filesystem, database, and application backup jobs. One backup at a time
#   to avoid I/O contention. Requires adequate destination space before start.
#   Strong serialisation: a running backup blocks the next one until complete.
#
# Design:
#   The once-per-period guard (queue:job_has_not_run) prevents duplicate
#   backups when the cron bridge fires twice or a manual resubmit is triggered.
#   Adjust time= to match your backup frequency.
#
# Site overrides:
#   QUEUEBASH_BACKUP_DEST_DIR    - backup destination (default /var/lib/backups)
#   QUEUEBASH_BACKUP_SOURCE_DIR  - source root to back up (default /var/lib/data)
#   QUEUEBASH_BACKUP_MIN_FREE_MB - minimum free space on destination (default 2048)

CLASS_ALLOW_PARALLEL=0
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto
CLASS_DEFAULT_SANDBOX_LEVEL=network-none
CLASS_DEFAULT_SECCOMP_PROFILE=docker-default
CLASS_DEFAULT_TIMEOUT=8h
CLASS_DEFAULT_KILL_AFTER=120s
CLASS_DEFAULT_MAX_LOG_SIZE_BYTES=52428800
CLASS_DEFAULT_LOG_OVERFLOW_POLICY=stderr-only

# Only one backup job anywhere on this host at a time.
queue_class_exclusive_claim "backup:slot"

# Destination must be mounted and have adequate space.
queue_class_shared_asset path mount \
  "${QUEUEBASH_BACKUP_DEST_DIR:-/var/lib/backups}"
queue_class_shared_asset path freespace \
  "${QUEUEBASH_BACKUP_DEST_DIR:-/var/lib/backups}" \
  min_mb="${QUEUEBASH_BACKUP_MIN_FREE_MB:-2048}"

# Source must exist.
queue_class_shared_asset path exists \
  "${QUEUEBASH_BACKUP_SOURCE_DIR:-/var/lib/data}"

# System must not be under I/O stress.
queue_class_shared_asset sys iowait "system" max_percent=30
queue_class_shared_asset sys memory_available "system" min_mb=256

# Once-per-period guard: do not start if a backup completed in the last 20 hours.
# Prevents duplicate runs from cron bridge double-fires or manual resubmits.
queue_class_shared_asset queue job_has_not_run "backup" \
  field=name \
  match=substr \
  time=20h \
  states=done

# Scheduling: backups run deep overnight.
queue_class_shared_asset time window "backup-window" \
  weekdays=mon-fri \
  weekday_windows=01:00-05:00 \
  weekends=sat-sun \
  weekend_windows=01:00-07:00
