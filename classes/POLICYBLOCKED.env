# bashqueues class: POLICYBLOCKED
#
# Purpose:
#   Test/validation class for the policy_blocked terminal state.
#   Pair with policies.d/class-statement/policyblock-test.env.
#
# A job submitted with --class POLICYBLOCKED should move to policy_blocked when
# the policyblock-test statement is active as a shared/admin policy and no valid
# command-bound authorisation is attached.

CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=0
CLASS_DEFAULT_RUNNER=auto
CLASS_DEFAULT_SANDBOX_LEVEL=queue-default
CLASS_DEFAULT_SECCOMP_PROFILE=queue-default
