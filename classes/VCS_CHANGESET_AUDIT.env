# bashqueues class: VCS_CHANGESET_AUDIT
#
# Purpose:
#   Reproducible source-control audit gate for jobs that must prove the exact
#   repository identity and revision/changelist before running. Useful for Git
#   commits, SVN revisions, CVS sticky tags, Mercurial changesets, and Perforce
#   changelists.
#
# Site overrides:
#   QUEUEBASH_VCS_AUDIT_REPO=/srv/src/project
#   QUEUEBASH_VCS_AUDIT_TYPE=auto|git|svn|cvs|hg|p4
#   QUEUEBASH_VCS_AUDIT_IDENTITY=main|HEAD|//depot/main|client-name
#   QUEUEBASH_VCS_AUDIT_REVISION=hash|revision|cvs-root|changelist

CLASS_ALLOW_PARALLEL=0
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_SANDBOX_LEVEL=restrict-egress
CLASS_DEFAULT_SECCOMP_PROFILE=docker-default
CLASS_DEFAULT_RUNTIME_CAPS=no-spawn-shell
CLASS_DEFAULT_TIMEOUT=45m
CLASS_DEFAULT_KILL_AFTER=30s

queue_class_exclusive_claim "vcs:audit:${QUEUEBASH_VCS_AUDIT_NAME:-default}"

queue_class_shared_asset vcs repo_exists \
  "${QUEUEBASH_VCS_AUDIT_REPO:-$PWD}" \
  type="${QUEUEBASH_VCS_AUDIT_TYPE:-auto}" \
  timeout="${QUEUEBASH_VCS_TIMEOUT:-10}"

queue_class_shared_asset vcs clean_tree \
  "${QUEUEBASH_VCS_AUDIT_REPO:-$PWD}" \
  type="${QUEUEBASH_VCS_AUDIT_TYPE:-auto}" \
  timeout="${QUEUEBASH_VCS_TIMEOUT:-20}"

if [[ -n "${QUEUEBASH_VCS_AUDIT_IDENTITY:-}" ]]; then
  queue_class_shared_asset vcs identity \
    "${QUEUEBASH_VCS_AUDIT_REPO:-$PWD}" \
    type="${QUEUEBASH_VCS_AUDIT_TYPE:-auto}" \
    require_identity="${QUEUEBASH_VCS_AUDIT_IDENTITY}" \
    timeout="${QUEUEBASH_VCS_TIMEOUT:-10}"
fi

if [[ -n "${QUEUEBASH_VCS_AUDIT_REVISION:-}" ]]; then
  queue_class_shared_asset vcs revision \
    "${QUEUEBASH_VCS_AUDIT_REPO:-$PWD}" \
    type="${QUEUEBASH_VCS_AUDIT_TYPE:-auto}" \
    require_revision="${QUEUEBASH_VCS_AUDIT_REVISION}" \
    timeout="${QUEUEBASH_VCS_TIMEOUT:-10}"
fi
