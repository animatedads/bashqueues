# bashqueues class: MSDOMAIN
#
# Purpose:
#   Template class for Microsoft-domain / hybrid Linux automation.
#
# This class is deliberately environment-driven so it can be installed safely
# without hard-coded secrets. Set only the variables that apply to the site.
# See docs/MSDOMAIN_ASSETS.md.

CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=0
CLASS_DEFAULT_RUNNER=auto

# Avoid hammering Graph/ARM endpoints from many jobs at once.
queue_class_global_shared_claim "microsoft:graph_api" slots="${MSDOMAIN_GRAPH_SLOTS:-4}"
queue_class_global_shared_claim "microsoft:arm_api" slots="${MSDOMAIN_ARM_SLOTS:-2}"

if [[ -n "${MSDOMAIN_LDAP_URI:-}" && -n "${MSDOMAIN_BIND_DN:-}" && -n "${MSDOMAIN_BIND_PASSWORD:-}" ]]; then
  queue_class_shared_asset msad ldap_bind "$MSDOMAIN_LDAP_URI" \
    bind_dn="$MSDOMAIN_BIND_DN" \
    password="$MSDOMAIN_BIND_PASSWORD" \
    base="${MSDOMAIN_LDAP_BASE:-}" \
    timeout="${MSDOMAIN_TIMEOUT:-10}"
fi

if [[ "${MSDOMAIN_REQUIRE_KERBEROS:-0}" == "1" ]]; then
  queue_class_shared_asset msad kerberos_ticket _
fi

if [[ -n "${MSDOMAIN_GRAPH_ENV_FILE:-}" && -n "${MSDOMAIN_GRAPH_ENV_KEY:-GRAPH_TOKEN}" ]]; then
  if [[ -n "${MSDOMAIN_SHAREPOINT_SITE_ID:-}" ]]; then
    queue_class_shared_asset mscloud sharepoint_access "$MSDOMAIN_SHAREPOINT_SITE_ID" \
      env_file="$MSDOMAIN_GRAPH_ENV_FILE" env_key="${MSDOMAIN_GRAPH_ENV_KEY:-GRAPH_TOKEN}" timeout="${MSDOMAIN_TIMEOUT:-10}"
  fi
  if [[ -n "${MSDOMAIN_EXCHANGE_MAILBOX:-}" ]]; then
    queue_class_shared_asset exchange mailbox_exists "$MSDOMAIN_EXCHANGE_MAILBOX" \
      env_file="$MSDOMAIN_GRAPH_ENV_FILE" env_key="${MSDOMAIN_GRAPH_ENV_KEY:-GRAPH_TOKEN}" timeout="${MSDOMAIN_TIMEOUT:-10}"
  fi
  if [[ -n "${MSDOMAIN_TEAMS_PRESENCE_UPN:-}" ]]; then
    queue_class_shared_asset teams graph_presence "$MSDOMAIN_TEAMS_PRESENCE_UPN" \
      env_file="$MSDOMAIN_GRAPH_ENV_FILE" env_key="${MSDOMAIN_GRAPH_ENV_KEY:-GRAPH_TOKEN}" timeout="${MSDOMAIN_TIMEOUT:-10}"
  fi
fi

if [[ -n "${MSDOMAIN_SMB_SHARE:-}" && -n "${MSDOMAIN_SMB_USER:-}" && -n "${MSDOMAIN_SMB_PASSWORD:-}" ]]; then
  queue_class_shared_asset msfs smb_mountable "$MSDOMAIN_SMB_SHARE" \
    user="$MSDOMAIN_SMB_USER" password="$MSDOMAIN_SMB_PASSWORD" timeout="${MSDOMAIN_TIMEOUT:-10}"
fi

if [[ -n "${MSDOMAIN_AZURE_ENV_FILE:-}" && -n "${MSDOMAIN_AZURE_RESOURCE_ID:-}" ]]; then
  queue_class_shared_asset azure resource_exists "$MSDOMAIN_AZURE_RESOURCE_ID" \
    env_file="$MSDOMAIN_AZURE_ENV_FILE" env_key="${MSDOMAIN_AZURE_ENV_KEY:-AZURE_TOKEN}" timeout="${MSDOMAIN_TIMEOUT:-10}"
fi

if [[ -n "${MSDOMAIN_VAULT_URI:-}" && -n "${MSDOMAIN_VAULT_SECRET:-}" && -n "${MSDOMAIN_AZURE_ENV_FILE:-}" ]]; then
  queue_class_shared_asset vault secret_exists "$MSDOMAIN_VAULT_SECRET" \
    vault_uri="$MSDOMAIN_VAULT_URI" env_file="$MSDOMAIN_AZURE_ENV_FILE" env_key="${MSDOMAIN_AZURE_ENV_KEY:-AZURE_TOKEN}" timeout="${MSDOMAIN_TIMEOUT:-10}"
fi

if [[ -n "${MSDOMAIN_WINRM_HOST:-}" && -n "${MSDOMAIN_WINRM_USER:-}" && -n "${MSDOMAIN_WINRM_PASSWORD:-}" ]]; then
  queue_class_exclusive_asset winrm connect "$MSDOMAIN_WINRM_HOST" \
    user="$MSDOMAIN_WINRM_USER" password="$MSDOMAIN_WINRM_PASSWORD" timeout="${MSDOMAIN_TIMEOUT:-10}"
fi
