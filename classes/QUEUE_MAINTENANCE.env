# bashqueues class: QUEUE_MAINTENANCE
#
# Purpose:
#   Safe default class for queue housekeeping jobs created from the panel
#   Maintenance view: health fixes, log rolling, log cleaning, and record
#   deletion/tidy-up commands.
#
# Design:
#   Maintenance commands should normally run as queued jobs, not as immediate
#   operator shell actions.  The panel still offers a direct run-now escape
#   hatch for urgent recovery, but the default path is scheduled and audited.

CLASS_ALLOW_PARALLEL=0
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto
CLASS_DEFAULT_TIMEOUT=1h
CLASS_DEFAULT_KILL_AFTER=30s
CLASS_DEFAULT_MAX_LOG_SIZE_BYTES=10485760
CLASS_DEFAULT_LOG_OVERFLOW_POLICY=stderr-only

# Keep maintenance operations serialized per queue root.
queue_class_exclusive_claim "queue:maintenance"

# Maintenance jobs normally call queue via bash -lc after sourcing queuebash.sh.
queue_class_shared_asset runnable path "bash"

# Avoid starting tidy-up work if the queue root or logs area is critically full.
queue_class_shared_asset path freespace "${QUEUEBASH_ROOT:-$HOME/.queuebash}" min_mb=50
queue_class_shared_asset path freespace "${QUEUEBASH_ROOT:-$HOME/.queuebash}/logs" min_mb=25
