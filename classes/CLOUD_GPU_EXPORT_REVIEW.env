# bashqueues class: CLOUD_GPU_EXPORT_REVIEW
# Purpose: Example GPU class for export-control-sensitive workloads. Contract/template only.
CLASS_ALLOW_PARALLEL=0
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=auto

queue_class_shared_asset gpu_cloud legal export_review=required status=mapped_pending_validation
queue_class_shared_asset gpu_cloud accelerator restricted_workload_review=1
queue_class_shared_asset gpu_cloud region approved_jurisdiction=1
queue_class_shared_asset gpu_cloud audit logging required=1
