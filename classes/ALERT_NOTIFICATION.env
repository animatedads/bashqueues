# bashqueues class: ALERT_NOTIFICATION
#
# Purpose:
#   Jobs whose sole purpose is sending alerts, notifications, and status
#   reports via email, webhook, SNMP trap, or messaging API.
#   Fast timeout, low priority ceiling, network permitted but metered.
#   Must not block on heavy prerequisites.
#
# Design:
#   Alert jobs should be lightweight and quick. The 5-minute timeout enforces
#   this. If an alert takes longer than 5 minutes to send, the channel is
#   broken and the job should fail fast so the operator can investigate.
#   No time window restriction — alerts must be able to fire at any hour.
#
# Site overrides:
#   QUEUEBASH_ALERT_SMTP_HOST  - SMTP host:port for reachability check
#   QUEUEBASH_ALERT_IFACE      - network interface for connectivity check

CLASS_ALLOW_PARALLEL=1
CLASS_MAX_CONCURRENT=5
CLASS_DEFAULT_RUNNER=auto
CLASS_DEFAULT_SANDBOX_LEVEL=restrict-egress
CLASS_DEFAULT_RUNTIME_CAPS=no-spawn-shell
CLASS_DEFAULT_RUNTIME_CAP_INTERVAL=1
CLASS_DEFAULT_TIMEOUT=5m
CLASS_DEFAULT_KILL_AFTER=15s
CLASS_DEFAULT_MAX_LOG_SIZE_BYTES=1048576

# Network interface must be up — if the link is down, alerts cannot be sent.
queue_class_shared_asset net interface_state \
  "${QUEUEBASH_ALERT_IFACE:-eth0}"

# No scheduling restriction — alerts fire any time.
