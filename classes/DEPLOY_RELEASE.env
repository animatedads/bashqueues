# bashqueues class: DEPLOY_RELEASE
#
# Purpose:
#   Application deployment and release promotion jobs. Strictly serialised.
#   Requires a clean git tree, reachable target, and adequate resources.
#
# Security model:
#   restrict-egress rather than network-none (deployments push artefacts).
#   no-spawn-shell prevents the deployed script opening new shell sessions.
#
# Site overrides:
#   QUEUEBASH_DEPLOY_REPO        - source repository path (default /opt/app)
#   QUEUEBASH_DEPLOY_BRANCH      - required branch (default main)
#   QUEUEBASH_DEPLOY_TARGET_HOST - deployment target for TCP health check
#   QUEUEBASH_DEPLOY_TARGET_PORT - deployment target port (default 22)
#   QUEUEBASH_DEPLOY_LOG_DIR     - deployment log directory

CLASS_ALLOW_PARALLEL=0
CLASS_MAX_CONCURRENT=1
CLASS_DEFAULT_RUNNER=systemd
CLASS_DEFAULT_SANDBOX_LEVEL=restrict-egress
CLASS_DEFAULT_SECCOMP_PROFILE=docker-default
CLASS_DEFAULT_RUNTIME_CAPS=no-spawn-shell
CLASS_DEFAULT_RUNTIME_CAP_INTERVAL=1
CLASS_DEFAULT_TIMEOUT=60m
CLASS_DEFAULT_KILL_AFTER=30s
CLASS_DEFAULT_MAX_LOG_SIZE_BYTES=52428800

queue_class_exclusive_claim "deploy:release:slot"

queue_class_shared_asset git repo_exists \
  "${QUEUEBASH_DEPLOY_REPO:-/opt/app}"
queue_class_shared_asset git branch \
  "${QUEUEBASH_DEPLOY_REPO:-/opt/app}" \
  require_branch="${QUEUEBASH_DEPLOY_BRANCH:-main}"
queue_class_shared_asset git clean_tree \
  "${QUEUEBASH_DEPLOY_REPO:-/opt/app}"

queue_class_shared_asset net tcp_endpoint \
  "${QUEUEBASH_DEPLOY_TARGET_HOST:-localhost}:${QUEUEBASH_DEPLOY_TARGET_PORT:-22}" \
  timeout=10

queue_class_shared_asset path freespace \
  "${QUEUEBASH_DEPLOY_LOG_DIR:-/var/log/deployments}" min_mb=100

queue_class_shared_asset sys cpu_load "system" max_load_1m=4.0
queue_class_shared_asset sys memory_available "system" min_mb=512

queue_class_shared_asset queue job_has_not_run "deploy" \
  field=name match=substr time=15m states=running
